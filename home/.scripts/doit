# --- Helper Functions ---

command_exists() {
  local cmd="$1"
  command -v "$cmd" >/dev/null 2>&1
}

update_config() {
  local jq_filter="$1"
  local tmp_file
  if ! command_exists jq; then
    echo -e "${RED}jq is required but not installed. Cannot update config.${NC}" >&2
    return 1
  fi
  tmp_file=$(mktemp)
  trap 'rm -f "$tmp_file"' EXIT HUP INT TERM
  if jq "$jq_filter" "$CONFIG_FILE" > "$tmp_file"; then
    if mv "$tmp_file" "$CONFIG_FILE"; then
      trap - EXIT HUP INT TERM
      return 0
    else
      echo -e "${RED}Error moving temp file to config file.${NC}" >&2
      rm -f "$tmp_file"
      trap - EXIT HUP INT TERM
      return 1
    fi
  else
    echo -e "${RED}Error processing config update with jq.${NC}" >&2
    rm -f "$tmp_file"
    trap - EXIT HUP INT TERM
    return 1
  fi
}

is_git_repo() {
  local dir="$1"
  git -C "$dir" rev-parse --git-dir > /dev/null 2>&1
}

use_fzf() {
  [[ "$USE_FZF" -eq 1 ]] && command_exists fzf
}

use_tmux() {
  [[ "$USE_TMUX" -eq 1 ]] && command_exists tmux
}

fzf_select() {
  local prompt="$1"
  shift
  local items=("${@}")
  local selected_item=""
  if use_fzf; then
    if [[ ${#items[@]} -eq 0 ]]; then
      echo ""
      return 0
    fi
    selected_item=$(printf "%s\n" "${items[@]}" | fzf --prompt="$prompt")
    echo "$selected_item"
  else
    echo -e "${YELLOW}fzf disabled or not found. Using 'select' for selection:${NC}" >&2
    if [[ ${#items[@]} -eq 0 ]]; then
      echo -e "${YELLOW}No items to select from.${NC}" >&2
      echo ""
      return 0
    fi
    local item PS3
    PS3="${prompt} "
    select item in "${items[@]}"; do
      if [[ -n "$item" ]]; then
        echo "$item"
        break
      else
        echo -e "${RED}Invalid selection.${NC}" >&2
        echo ""
        break
      fi
    done
  fi
}

tmux_edit() {
  local file="$1"
  if use_tmux; then
    if [[ -z "$TMUX" ]]; then
      echo -e "${YELLOW}tmux integration enabled, but not running inside tmux. Opening in default editor.${NC}" >&2
      ${EDITOR} "$file"
      return
    fi
    if ! tmux list-windows -F '#{window_name}' | grep -q "^${TMUX_WINDOW_NAME}$"; then
      local escaped_file
      escaped_file=$(printf "%s" "$file" | sed "s/'/'\\\\''/g")
      tmux new-window -n "$TMUX_WINDOW_NAME" "${EDITOR} '${escaped_file}'"
    else
      local escaped_file
      escaped_file=$(printf "%s" "$file" | sed "s/'/'\\\\''/g")
      tmux send-keys -t "$TMUX_WINDOW_NAME" C-u "${EDITOR} '${escaped_file}'" C-m
      tmux select-window -t "$TMUX_WINDOW_NAME"
    fi
  else
    ${EDITOR} "$file"
  fi
}

project_file() {
  local path="$1"
  echo "$(basename "$path")${DEFAULT_TODO_EXTENSION}"
}

get_last_project() {
  if [[ -n "$LAST_PROJECT" ]]; then
    echo "$LAST_PROJECT"
  elif command_exists jq; then
    jq -r '.last_project // empty' "$CONFIG_FILE" 2>/dev/null || echo ""
  else
    echo ""
  fi
}

set_last_project() {
  local project_path="$1"
  LAST_PROJECT="$project_path"
  if ! update_config ".last_project = \"$project_path\""; then
    echo -e "${YELLOW}Warning: Failed to update last_project in config file.${NC}" >&2
  fi
}

sanitize_filename() {
  local filename="$1"
  echo "$filename" | sed -e 's/[^a-zA-Z0-9._-]\+/-/g' -e 's/^-+//' -e 's/-+$//'
}

ensure_cheatsheet_dir() {
  if ! mkdir -p "${CHEATSHEET_DIR}"; then
    echo -e "${RED}Error: Failed to create cheatsheet directory: ${CHEATSHEET_DIR}${NC}" >&2
    exit 1
  fi
}

