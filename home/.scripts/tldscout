#!/bin/bash
# TLDScout Ultimate - No Curl Dependency

# Configuration
TIMEOUT=3
DEFAULT_PORTS="80 443"

# Style definitions
BOLD=$(tput bold)
BLUE=$(tput setaf 4)
GREEN=$(tput setaf 2)
YELLOW=$(tput setaf 3)
RED=$(tput setaf 1)
RESET=$(tput sgr0)

header() {
    echo -e "${BOLD}${BLUE}  Scanning: $1.※${RESET}"
    echo -e "${BLUE}──────────────────────────────────────────${RESET}"
}

fetch_tlds() {
    # Pure Bash HTTP client
    exec 3<>/dev/tcp/data.iana.org/80
    echo -e "GET /TLD/tlds-alpha-by-domain.txt HTTP/1.1\r\nHost: data.iana.org\r\nConnection: close\r\n\r\n" >&3
    awk 'NR>1 && /^[a-zA-Z]+$/ {print tolower($0)}' <&3
    exec 3>&-
}

detect_services() {
    local domain=$1
    local services=()

    # HTTPS Service Detection
    if timeout $TIMEOUT bash -c "exec 3<>/dev/tcp/$domain/443" 2>/dev/null; then
        local https_response=$(timeout $TIMEOUT openssl s_client -connect "$domain:443" -servername "$domain" 2>&1)

        # Detect Web Server
        if echo "$https_response" | grep -q "HTTP/"; then
            services+=("${GREEN} Web Server${RESET}")

            # Check TLS Configuration
            if echo "$https_response" | grep -q "TLSv1.3"; then
                services+=("${GREEN} TLS 1.3${RESET}")
            elif echo "$https_response" | grep -q "TLSv1.2"; then
                services+=("${YELLOW} TLS 1.2${RESET}")
            else
                services+=("${RED} Weak TLS${RESET}")
            fi
        fi
    fi

    # HTTP Service Detection
    if timeout $TIMEOUT bash -c "exec 3<>/dev/tcp/$domain/80" 2>/dev/null; then
        local http_response=$(timeout $TIMEOUT bash -c "exec 3<>/dev/tcp/$domain/80; echo -e 'GET / HTTP/1.1\r\nHost: $domain\r\nConnection: close\r\n\r\n' >&3; cat <&3")

        if echo "$http_response" | grep -q "HTTP/"; then
            services+=("${YELLOW} HTTP Server${RESET}")

            # Detect Redirects
            if echo "$http_response" | grep -q "301 Moved Permanently"; then
                local location=$(echo "$http_response" | grep -i "location:" | cut -d' ' -f2 | tr -d '\r')
                services+=("${BLUE} Redirect → ${location}${RESET}")

                # Detect ww16 or similar shady redirects
                if echo "$location" | grep -qi "ww[0-9]\+"; then
                    services+=("${RED} Suspicious Redirect (wwXX detected)${RESET}")
                fi
            fi
        fi
    fi

    echo "${services[*]}"
}

check_dns_records() {
    local domain=$1
    local records=()

    # Common DNS Records
    local a_record=$(dig +short A "$domain")
    local mx_record=$(dig +short MX "$domain")
    local txt_record=$(dig +short TXT "$domain")

    [ -n "$a_record" ] && records+=("A: $a_record")
    [ -n "$mx_record" ] && records+=("MX: $mx_record")
    [ -n "$txt_record" ] && records+=("TXT: $txt_record")

    echo "${records[*]}"
}

check_blacklists() {
    local domain=$1
    local blacklists=()

    # Common DNSBLs
    local blacklist_servers=(
        "zen.spamhaus.org"
        "bl.spamcop.net"
        "b.barracudacentral.org"
    )

    for server in "${blacklist_servers[@]}"; do
        if dig +short "$domain"@"$server" | grep -qE '^127\.'; then
            blacklists+=("${RED} $server${RESET}")
        fi
    done

    echo "${blacklists[*]}"
}

check_domain() {
    local domain="${1}.${2}"
    local resolved_ip

    # DNS resolution
    resolved_ip=$(getent hosts "$domain" | awk '{print $1}' | head -n1)
    [ -z "$resolved_ip" ] && return

    # Service detection
    local services=$(detect_services "$domain")
    [ -z "$services" ] && return

    # DNS Records
    local dns_records=$(check_dns_records "$domain")

    # Blacklist Check
    local blacklist_status=$(check_blacklists "$domain")

    # Output
    echo -e "${BOLD} ${domain}${RESET}"
    echo -e "   ${BLUE}IP:${RESET} ${resolved_ip}"
    echo -e "   ${BLUE}Services:${RESET} ${services}"
    [ -n "$dns_records" ] && echo -e "   ${BLUE}DNS Records:${RESET} ${dns_records}"
    [ -n "$blacklist_status" ] && echo -e "   ${BLUE}Blacklist Status:${RESET} ${blacklist_status}"
    echo -e "${BLUE}──────────────────────────────────────────${RESET}"
}

main() {
    [ -z "$1" ] && {
        echo -e "   Usage: $0 <domain_name>"
        exit 1
    }

    local domain=$1
    header "$domain"

    # Get TLD list
    TLD_LIST=$(fetch_tlds)

    while read -r tld; do
        check_domain "$domain" "$tld"
    done <<<"$TLD_LIST"

    echo -e "${BLUE} Scan completed${RESET}"
}

main "$@"
