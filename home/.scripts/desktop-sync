#!/usr/bin/env bash
# lutris-desktop-sync — generate .desktop launchers for every Lutris game so
# they show up directly in your app launcher (fuzzel/rofi/menu).
#
# Lutris only creates shortcuts per-game, on demand, from its UI. This syncs
# them all in one shot, and can install a systemd --user watcher so new games
# get an entry automatically the moment Lutris's library changes.
#
# Generated files:  ~/.local/share/applications/lutris-<slug>.desktop
# Each carries  X-Lutris-Managed=true  so a prune only ever touches our files.
#
# Usage
#   lutris-desktop-sync                       sync now (add/update entries)
#   lutris-desktop-sync --prune               also delete entries for removed games
#   lutris-desktop-sync --list                show what would be generated (no writes)
#   lutris-desktop-sync --cover <slug> <url>  download and assign custom cover art
#   lutris-desktop-sync --install             install + enable the auto-sync watcher
#   lutris-desktop-sync --uninstall           remove watcher AND all managed entries
#   lutris-desktop-sync -h|--help             this help

set -euo pipefail

APPS="$HOME/.local/share/applications"
ICON_HICOLOR="$HOME/.local/share/icons/hicolor/128x128/apps"
COVERART="$HOME/.local/share/lutris/coverart"
LUTRIS_DB="$HOME/.local/share/lutris/pga.db"
UNIT_DIR="$HOME/.config/systemd/user"
PREFIX="lutris-"

log() { printf '\e[1;36m▶ %s\e[0m\n' "$*"; }
ok()  { printf '\e[1;32m✓ %s\e[0m\n' "$*"; }
warn(){ printf '\e[1;33m! %s\e[0m\n' "$*"; }
err() { printf '\e[1;31m✗ %s\e[0m\n' "$*" >&2; }

# Generation reads Lutris's SQLite DB directly (no GUI/display needed, so this
# works from a headless systemd service). lutris itself is only needed at
# launch time (the Exec= line), so a missing binary is just a warning here.
command -v sqlite3 >/dev/null || { err "sqlite3 not installed (needed to read the Lutris library)"; exit 1; }
command -v lutris  >/dev/null || warn "lutris not on PATH — entries will still generate but won't launch"

# ── generate/update entries. Prints the basenames it wrote. ────────────────
generate() {
    local dry="${1:-0}"
    mkdir -p "$APPS"
    # Capture the JSON to a temp file — piping it while also using a heredoc
    # for the program would make the heredoc python's stdin, dropping the data.
    local tmp; tmp="$(mktemp)"
    trap 'rm -f "$tmp"' RETURN
    # Read installed games straight from the DB. A read failure returns
    # non-zero so callers abort *before* pruning — we never delete entries
    # just because the DB was momentarily unreadable/locked.
    if ! sqlite3 -json "$LUTRIS_DB" \
        "SELECT id, slug, name, runner FROM games WHERE installed = 1 ORDER BY name COLLATE NOCASE;" \
        > "$tmp" 2>/dev/null; then
        err "could not read Lutris database: $LUTRIS_DB"
        return 1
    fi
    [[ -s "$tmp" ]] || echo "[]" > "$tmp"   # sqlite prints nothing for 0 rows
    DRY="$dry" APPS="$APPS" PREFIX="$PREFIX" GAMES_FILE="$tmp" \
        HIC="$ICON_HICOLOR" COVER="$COVERART" python3 <<'PY'
import json, os, sys
apps  = os.environ["APPS"]
pref  = os.environ["PREFIX"]
hic   = os.environ["HIC"]
cover = os.environ["COVER"]
dry   = os.environ["DRY"] == "1"

try:
    with open(os.environ["GAMES_FILE"]) as fh:
        games = json.load(fh)
except Exception:
    games = []

def pick_icon(slug):
    # Prefer an installed icon *name* (theme-resolved), else a coverart file.
    if os.path.exists(os.path.join(hic, f"lutris_{slug}.png")):
        return f"lutris_{slug}"
    
    # Check if a local coverart file already exists
    for ext in ("jpg", "png", "jpeg", "webp"):
        p = os.path.join(cover, f"{slug}.{ext}")
        if os.path.exists(p):
            return p
            
    if dry:
        return "lutris"

    # Try to automatically download from Lutris cover repository!
    import urllib.request
    url = f"https://lutris.net/games/cover/{slug}.jpg"
    dest = os.path.join(cover, f"{slug}.jpg")
    try:
        os.makedirs(cover, exist_ok=True)
        req = urllib.request.Request(
            url, 
            headers={'User-Agent': 'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36'}
        )
        with urllib.request.urlopen(req, timeout=5) as response:
            if response.status == 200:
                with open(dest, "wb") as f:
                    f.write(response.read())
                print(f"Downloaded cover art for '{slug}'")
                return dest
    except Exception:
        pass

    return "lutris"

written = []
for g in games:
    slug = g.get("slug")
    gid  = g.get("id")
    name = g.get("name") or slug
    if not slug or gid is None:
        continue
    runner = g.get("runner") or ""
    # Desktop-entry escaping: name/comment shouldn't contain raw newlines.
    name = str(name).replace("\n", " ").strip()
    icon = pick_icon(slug)
    fn   = f"{pref}{slug}.desktop"
    body = (
        "[Desktop Entry]\n"
        "Type=Application\n"
        f"Name={name}\n"
        f"Comment=Lutris game ({runner})\n"
        f"Exec=lutris lutris:rungameid/{gid}\n"
        f"Icon={icon}\n"
        "Terminal=false\n"
        "Categories=Game;\n"
        f"Keywords=lutris;game;{runner};\n"
        "StartupNotify=true\n"
        "X-Lutris-Managed=true\n"
        f"X-Lutris-Slug={slug}\n"
    )
    if dry:
        print(f"{fn}\t{name}\t[{icon}]")
    else:
        with open(os.path.join(apps, fn), "w") as f:
            f.write(body)
        written.append(fn)

if not dry:
    print("\n".join(written))
PY
}

# ── remove managed entries whose game no longer exists ─────────────────────
prune() {
    local keep="$1"   # newline-separated list of current basenames
    local removed=0
    shopt -s nullglob
    for f in "$APPS/$PREFIX"*.desktop; do
        base=$(basename "$f")
        # Only ever touch files we manage.
        grep -q '^X-Lutris-Managed=true$' "$f" 2>/dev/null || continue
        if ! grep -qxF "$base" <<<"$keep"; then
            rm -f "$f"; removed=$((removed + 1)); warn "pruned $base"
        fi
    done
    # Note: `removed=$((...))` (not `((removed++))`) — the latter returns exit 1
    # when the value is 0, which trips `set -e`.
    if (( removed )); then
        ok "pruned $removed stale entr$([ "$removed" -eq 1 ] && echo y || echo ies)"
    fi
}

refresh_menu() {
    command -v update-desktop-database >/dev/null && \
        update-desktop-database "$APPS" >/dev/null 2>&1 || true
}

# ── systemd --user watcher: re-sync whenever the Lutris DB changes ─────────
install_watcher() {
    mkdir -p "$UNIT_DIR"
    local self; self="$(realpath "$0")"

    cat > "$UNIT_DIR/lutris-desktop-sync.service" <<EOF
[Unit]
Description=Sync Lutris games to .desktop launchers

[Service]
Type=oneshot
ExecStart=$self --prune
EOF

    cat > "$UNIT_DIR/lutris-desktop-sync.path" <<EOF
[Unit]
Description=Watch the Lutris library and regenerate .desktop launchers

[Path]
PathModified=$LUTRIS_DB
Unit=lutris-desktop-sync.service

[Install]
WantedBy=default.target
EOF

    systemctl --user daemon-reload
    systemctl --user enable --now lutris-desktop-sync.path
    ok "watcher installed — new/removed games now sync automatically"
}

uninstall() {
    systemctl --user disable --now lutris-desktop-sync.path 2>/dev/null || true
    rm -f "$UNIT_DIR/lutris-desktop-sync.path" "$UNIT_DIR/lutris-desktop-sync.service"
    systemctl --user daemon-reload 2>/dev/null || true
    shopt -s nullglob
    local n=0
    for f in "$APPS/$PREFIX"*.desktop; do
        if grep -q '^X-Lutris-Managed=true$' "$f" 2>/dev/null; then
            rm -f "$f"; n=$((n + 1))
        fi
    done
    refresh_menu
    ok "removed watcher + $n managed entr$([ "$n" -eq 1 ] && echo y || echo ies)"
}

# ── main ───────────────────────────────────────────────────────────────────
case "${1:-sync}" in
    -h|--help)   sed -n '2,22p' "$0" | sed 's/^# \?//'; exit 0 ;;
    --list)
        log "would generate:"
        generate 1 | column -t -s $'\t' | sed 's/^/  /'
        exit 0 ;;
    --install)   install_watcher ;;
    --uninstall) uninstall; exit 0 ;;
    --cover)
        if [[ $# -lt 3 ]]; then
            err "Usage: lutris-desktop-sync --cover <slug> <url>"
            exit 1
        fi
        slug="$2"
        url="$3"
        # Extract extension from URL, fallback to png
        ext="${url##*.}"
        # Strip query parameters from extension if any
        ext="${ext%%\?*}"
        # Validate extension or default to png
        if [[ ! "$ext" =~ ^(png|jpg|jpeg|webp)$ ]]; then
            ext="png"
        fi
        dest="$COVERART/$slug.$ext"
        log "Downloading cover for '$slug' from '$url'..."
        mkdir -p "$COVERART"
        # Remove any existing cover files of different extensions so they don't conflict
        rm -f "$COVERART/$slug".*
        if curl -sSL -o "$dest" "$url"; then
            ok "Downloaded cover to $dest"
            # Now run the sync
            log "syncing Lutris games → $APPS"
            entries="$(generate 0)"
            count=$(grep -c . <<<"$entries" || true)
            refresh_menu
            ok "$count game entries synced with new cover"
        else
            err "Failed to download cover from $url"
            exit 1
        fi
        exit 0 ;;
    --prune|sync|"")
        log "syncing Lutris games → $APPS"
        entries="$(generate 0)"
        count=$(grep -c . <<<"$entries" || true)
        [[ "${1:-}" == "--prune" ]] && prune "$entries"
        refresh_menu
        ok "$count game entr$([ "$count" -eq 1 ] && echo y || echo ies) synced" ;;
    *) err "unknown option: $1"; sed -n '10,19p' "$0" | sed 's/^# \?//'; exit 1 ;;
esac
