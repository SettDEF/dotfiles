set notification-error-bg       "#1a1a1d"
set notification-error-fg       "#e76b71"
set notification-warning-bg     "#1a1a1d"
set notification-warning-fg     "#ff7f50"
set notification-bg             "#1a1a1d"
set notification-fg             "#b0b0b0"

set completion-bg               "#2a2f3b"
set completion-fg               "#b0b0b0"
set completion-group-bg         "#4b5b73"
set completion-group-fg         "#b0b0b0"
set completion-highlight-bg     "#66b2d6"
set completion-highlight-fg     "#4b5b73"

set index-bg                    "#1a1a1d"
set index-fg                    "#ff8c00"
set index-active-bg             "#2a2f3b"
set index-active-fg             "#ff8c00"

set inputbar-bg                 "#191c24"
set inputbar-fg                 "#4d4d4d"

set statusbar-bg                "#1a1a1d"
set statusbar-fg                "#4d4d4d"

set highlight-color             "#ff7f50"
set highlight-active-color      "#ff4500"

set default-bg                  "#2b2b34"
set default-fg                  "#4d4d4d"
set render-loading              "true"
set render-loading-bg           "#1a1a1d"
set render-loading-fg           "#b2a8c9"

set recolor-lightcolor          "#2b2b34"
set recolor-darkcolor           "#faf0e6"

# Dark mode/invert.
set recolor                     "false" 

# Font.
set font "JetBrainsMono Nerd Font 10"

# Open document in fit-width mode by default
set adjust-open "best-fit"

# Pages per row.
set pages-per-row 1

set database sqlite

# Options
set synctex true
set synctex-editor-command "vim --remote +%{line} %{input}"

# ── Material You colours ─────────────────────────────────────────────────
# Generated by tinct from the current wallpaper palette; regenerated on every
# wallpaper change. Placed LAST on purpose — zathura applies directives in
# order and the last wins, so this overrides the literal colours above without
# them needing to be removed from a hand-maintained file.
# Remove this line to go back to the hardcoded colours.
include colors.rc
# Glass: written by the shell's Palette > Glass panel.
include glass.rc
