edit_cheatsheet() {
  local tool="$1"
  ensure_cheatsheet_dir
  if [ -z "$tool" ]; then
    local cheatsheets=()
    mapfile -t cheatsheets < <(find "${CHEATSHEET_DIR}" -type f -name "*${CHEATSHEET_EXTENSION}" -exec sh -c 'echo "$(basename {} ${CHEATSHEET_EXTENSION})|$(dirname {} | sed "s|${CHEATSHEET_DIR}/||")"' \; | sort)
    if [ ${#cheatsheets[@]} -eq 0 ]; then
      echo -e "${YELLOW}No cheatsheets found in ${CHEATSHEET_DIR}. Create one with './todo.sh cheatsheet create'.${NC}"
      return 1
    fi
    local selected=$(printf "%s\n" "${cheatsheets[@]}" | fzf --prompt="Select cheatsheet to edit: " --preview="bat --style=plain --color=always ${CHEATSHEET_DIR}/{2}/{1}${CHEATSHEET_EXTENSION} 2>/dev/null || glow ${CHEATSHEET_DIR}/{2}/{1}${CHEATSHEET_EXTENSION} 2>/dev/null || cat ${CHEATSHEET_DIR}/{2}/{1}${CHEATSHEET_EXTENSION}")
    if [ -z "$selected" ]; then
      echo -e "${YELLOW}No cheatsheet selected.${NC}"
      return 1
    fi
    tool=$(echo "$selected" | cut -d'|' -f1)
    local category=$(echo "$selected" | cut -d'|' -f2)
    local file="${CHEATSHEET_DIR}/${category}/${tool}${CHEATSHEET_EXTENSION}"
    tmux_edit "$file"
    echo -e "${GREEN}Edited cheatsheet:${NC} $file"
  else
    local file=$(find "${CHEATSHEET_DIR}" -type f -name "${tool}${CHEATSHEET_EXTENSION}" | head -n 1)
    if [ -z "$file" ]; then
      echo -e "${RED}Cheatsheet not found for tool: ${tool}${NC}"
      return 1
    fi
    tmux_edit "$file"
    echo -e "${GREEN}Edited cheatsheet:${NC} $file"
  fi
}

search_cheatsheet_commands() {
  local query="$1"
  ensure_cheatsheet_dir
  if [ -z "$query" ]; then
    read -r -p "$(echo -e "${YELLOW}Enter search query for commands:${NC} ")" query
  fi
  if [ -z "$query" ]; then
    echo -e "${YELLOW}Search query cannot be empty.${NC}" >&2
    return 1
  fi
  echo -e "${GREEN}Searching for '${query}' in cheatsheets:${NC}"
  local results=()
  mapfile -t results < <(find "${CHEATSHEET_DIR}" -type f -name "*${CHEATSHEET_EXTENSION}" -exec sh -c "sed -n '/^---$/,/^---$/d; /^[[:space:]]*$/d; p' {} | grep -in \"$query\" | sed 's|^\([0-9]*\):\(.*\)|{}:\1:\2|'" \;)
  if [ ${#results[@]} -eq 0 ]; then
    echo -e "${YELLOW}No commands found matching '${query}'.${NC}"
    return 1
  fi
  if use_fzf; then
    local selected=$(printf "%s\n" "${results[@]}" | fzf --prompt="Select command: " --preview="echo {} | cut -d':' -f1 | xargs -I % sh -c 'bat --style=plain --color=always % 2>/dev/null || glow % 2>/dev/null || cat %'" --preview-window=up:50%)
    if [ -n "$selected" ]; then
      local file=$(echo "$selected" | cut -d':' -f1)
      local command=$(echo "$selected" | cut -d':' -f3-)
      echo "#cheatsheet:$command" >> "${HOME}/.zsh_history"
      if command_exists xclip; then
        echo -n "$command" | xclip -selection clipboard
        echo -e "${GREEN}Command copied to clipboard:${NC} ${command}"
      else
        echo -e "${YELLOW}xclip not found. Command:${NC} ${command}"
      fi
    fi
  else
    printf "%s\n" "${results[@]}" | nl -w2 -s'. '
    read -r -p "$(echo -e "${YELLOW}Enter number to copy command:${NC} ")" num
    if [[ "$num" =~ ^[0-9]+$ ]]; then
      local selected=$(printf "%s\n" "${results[@]}" | sed -n "${num}p")
      if [ -n "$selected" ]; then
        local file=$(echo "$selected" | cut -d':' -f1)
        local command=$(echo "$selected" | cut -d':' -f3-)
        echo "#cheatsheet:$command" >> "${HOME}/.zsh_history"
        if command_exists xclip; then
          echo -n "$command" | xclip -selection clipboard
          echo -e "${GREEN}Command copied to clipboard:${NC} ${command}"
        else
          echo -e "${YELLOW}xclip not found. Command:${NC} ${command}"
        fi
      fi
    fi
  fi
}

search_cheatsheet_history() {
  local query="$1"
  if [ ! -f "${HOME}/.zsh_history" ]; then
    echo -e "${YELLOW}ZSH history file not found at ${HOME}/.zsh_history.${NC}"
    return 1
  fi
  if use_fzf; then
    local selected=$(grep "#cheatsheet:" "${HOME}/.zsh_history" | sed 's/.*#cheatsheet://' | sort -u | fzf --prompt="Select command from history: " --preview="echo {} | bat --style=plain --color=always --language=sh 2>/dev/null || cat -" --preview-window=up:50% --query="$query")
    if [ -n "$selected" ]; then
      if command_exists xclip; then
        echo -n "$selected" | xclip -selection clipboard
        echo -e "${GREEN}Command copied to clipboard:${NC} ${selected}"
      else
        echo -e "${YELLOW}xclip not found. Command:${NC} ${selected}"
      fi
    fi
  else
    echo -e "${GREEN}Cheatsheet Command History:${NC}"
    grep "#cheatsheet:" "${HOME}/.zsh_history" | sed 's/.*#cheatsheet://' | sort -u | nl -w2 -s'. '
    read -r -p "$(echo -e "${YELLOW}Enter number to copy command:${NC} ")" num
    if [[ "$num" =~ ^[0-9]+$ ]]; then
      local selected=$(grep "#cheatsheet:" "${HOME}/.zsh_history" | sed 's/.*#cheatsheet://' | sort -u | sed -n "${num}p")
      if [ -n "$selected" ]; then
        if command_exists xclip; then
          echo -n "$selected" | xclip -selection clipboard
          echo -e "${GREEN}Command copied to clipboard:${NC} ${selected}"
        else
          echo -e "${YELLOW}xclip not found. Command:${NC} ${selected}"
        fi
      fi
    fi
  fi
}

# --- Project Management Functions ---

add_project() {
  local path="$1"
  if [[ -z "$path" ]]; then
    read -r -p "$(毎年 -e "${YELLOW}Enter project path:${NC} ")" path
  fi
  path=$(realpath "$path" 2>/dev/null || echo "$path")
  if [[ ! -d "$path" ]]; then
    echo -e "${RED}Error: Directory does not exist: ${path}${NC}" >&2
    return 1
  fi
  if ! command_exists jq; then
    echo -e "${RED}jq is required but not installed. Cannot add project.${NC}" >&2
    return 1
  fi
  local project_list
  project_list=$(jq -r '.projects[]' "$CONFIG_FILE" 2>/dev/null || echo "")
  if echo "$project_list" | grep -Fx "$path" > /dev/null; then
    echo -e "${YELLOW}Project already exists: ${path}${NC}"
    return 0
  fi
  if ! update_config ".projects += [\"$path\"]"; then
    echo -e "${RED}Error adding project to config file.${NC}" >&2
    return 1
  fi
  echo -e "${GREEN}Project added: ${path}${NC}"
}

list_projects() {
  if ! command_exists jq; then
    echo -e "${RED}jq is required but not installed. Cannot list projects.${NC}" >&2
    return 1
  fi
  local projects
  projects=$(jq -r '.projects[]' "$CONFIG_FILE" 2>/dev/null || echo "")
  if [[ -z "$projects" ]]; then
    echo -e "${YELLOW}No projects configured. Add one with 'add-project'.${NC}"
    return 0
  fi
  echo -e "${GREEN}Configured Projects:${NC}"
  echo "$projects" | nl -w2 -s'. '
}

select_project() {
  if ! command_exists jq; then
    echo -e "${RED}jq is required but not installed. Cannot select project.${NC}" >&2
    return 1
  fi
  local projects=()
  mapfile -t projects < <(jq -r '.projects[]' "$CONFIG_FILE" 2>/dev/null || echo "")
  projects+=("global")
  if [[ ${#projects[@]} -eq 0 ]]; then
    echo -e "${YELLOW}No projects configured. Add one with 'add-project'.${NC}"
    return 1
  fi
  local selected_project
  selected_project=$(fzf_select "Select a project: " "${projects[@]}")
  if [[ -z "$selected_project" ]]; then
    echo -e "${YELLOW}No project selected.${NC}"
    return 1
  fi
  if [[ "$selected_project" == "global" ]]; then
    echo "${HOME}/todos/global"
  else
    if [[ ! -d "$selected_project" ]]; then
      echo -e "${RED}Error: Project directory does not exist: ${selected_project}${NC}" >&2
      return 1
    fi
    echo "$selected_project"
  fi
}

remove_project() {
  local path="$1"
  if [[ -z "$path" ]]; then
    local projects=()
    mapfile -t projects < <(jq -r '.projects[]' "$CONFIG_FILE" 2>/dev/null || echo "")
    if [[ ${#projects[@]} -eq 0 ]]; then
      echo -e "${YELLOW}No projects configured.${NC}"
      return 0
    fi
    path=$(fzf_select "Select project to remove: " "${projects[@]}")
  fi
  if [[ -z "$path" ]]; then
    echo -e "${YELLOW}No project selected.${NC}"
    return 0
  fi
  path=$(realpath "$path" 2>/dev/null || echo "$path")
  if ! command_exists jq; then
    echo -e "${RED}jq is required but not installed. Cannot remove project.${NC}" >&2
    return 1
  fi
  local project_list
  project_list=$(jq -r '.projects[]' "$CONFIG_FILE" 2>/dev/null || echo "")
  if ! echo "$project_list" | grep -Fx "$path" > /dev/null; then
    echo -e "${YELLOW}Project not found: ${path}${NC}"
    return 0
  fi
  if ! update_config ".projects -= [\"$path\"]"; then
    echo -e "${RED}Error removing project from config file.${NC}" >&2
    return 1
  fi
  echo -e "${GREEN}Project removed: ${path}${NC}"
}

edit_config() {
  if [[ ! -f "$CONFIG_FILE" ]]; then
    echo -e "${RED}Config file does not exist: ${CONFIG_FILE}${NC}" >&2
    return 1
  fi
  tmux_edit "$CONFIG_FILE"
  load_config_vars
  echo -e "${GREEN}Configuration file edited: ${CONFIG_FILE}${NC}"
}

set_editor() {
  local editor="$1"
  if [[ -z "$editor" ]]; then
    read -r -p "$(echo -e "${YELLOW}Enter editor command (e.g., nvim, vim, nano):${NC} ")" editor
  fi
  if [[ -z "$editor" ]]; then
    echo -e "${RED}Editor cannot be empty.${NC}" >&2
    return 1
  fi
  if ! command_exists "$editor"; then
    echo -e "${RED}Editor not found: ${editor}${NC}" >&2
    return 1
  fi
  if ! update_config ".editor = \"$editor\""; then
    echo -e "${RED}Error updating editor in config file.${NC}" >&2
    return 1
  fi
  EDITOR="$editor"
  echo -e "${GREEN}Editor set to: ${editor}${NC}"
}

enable_fzf() {
  if ! command_exists fzf; then
    echo -e "${RED}fzf is not installed. Please install fzf to enable integration.${NC}" >&2
    return 1
  fi
  if ! update_config '.use_fzf = 1'; then
    echo -e "${RED}Error enabling fzf in config file.${NC}" >&2
    return 1
  fi
  USE_FZF=1
  echo -e "${GREEN}fzf integration enabled.${NC}"
}

disable_fzf() {
  if ! update_config '.use_fzf = 0'; then
    echo -e "${RED}Error disabling fzf in config file.${NC}" >&2
    return 1
  fi
  USE_FZF=0
  echo -e "${GREEN}fzf integration disabled.${NC}"
}

enable_tmux() {
  if ! command_exists tmux; then
    echo -e "${RED}tmux is not installed. Please install tmux to enable integration.${NC}" >&2
    return 1
  fi
  if ! update_config '.use_tmux = 1'; then
    echo -e "${RED}Error enabling tmux in config file.${NC}" >&2
    return 1
  fi
  USE_TMUX=1
  echo -e "${GREEN}tmux integration enabled.${NC}"
}

disable_tmux() {
  if ! update_config '.use_tmux = 0'; then
    echo -e "${RED}Error disabling tmux in config file.${NC}" >&2
    return 1
  fi
  USE_TMUX=0
  echo -e "${GREEN}tmux integration disabled.${NC}"
}

show_dashboard() {
  if ! command_exists jq; then
    echo -e "${RED}jq is required but not installed. Cannot show dashboard.${NC}" >&2
    return 1
  fi
  local projects=()
  mapfile -t projects < <(jq -r '.projects[]' "$CONFIG_FILE" 2>/dev/null || echo "")
  if [[ ${#projects[@]} -eq 0 ]]; then
    echo -e "${YELLOW}No projects configured. Add one with 'add-project'.${NC}"
    return 0
  fi
  echo -e "${BLUE}${BOLD}=== Project Dashboard ===${NC}"
  for project in "${projects[@]}"; do
    if [[ ! -d "$project" ]]; then
      echo -e "${RED}Project directory not found: ${project}${NC}"
      continue
    fi
    local todo_count=0 done_count=0
    todo_count=$(find "$project" -maxdepth 1 -type f -name "*${DEFAULT_TODO_EXTENSION}" -not -path "*/${ARCHIVE_FOLDER}/*" | wc -l)
    done_count=$(find "$project/${ARCHIVE_FOLDER}" -type f -name "*${DEFAULT_TODO_EXTENSION}" 2>/dev/null | wc -l)
    echo -e "${GREEN}Project:${NC} ${project}"
    echo -e "  ${YELLOW}Active TODOs:${NC} ${todo_count}"
    echo -e "  ${YELLOW}Completed TODOs:${NC} ${done_count}"
    if is_git_repo "$project"; then
      local git_status
      git_status=$(git -C "$project" status --short | wc -l)
      echo -e "  ${YELLOW}Git Changes:${NC} ${git_status}"
    fi
    echo
  done
}

# --- TODO Management Functions ---

create_todo() {
  local folder="$1"
  local name="$2"
  local priority="$3"
  local tags="$4"
  if [[ -z "$folder" ]]; then
    folder=$(select_project)
    if [[ -z "$folder" ]]; then
      echo -e "${YELLOW}No project selected.${NC}"
      return 1
    fi
  fi
  if [[ ! -d "$folder" ]]; then
    echo -e "${RED}Error: Project directory does not exist: ${folder}${NC}" >&2
    return 1
  fi
  if [[ -z "$name" ]]; then
    read -r -p "$(echo -e "${YELLOW}Enter TODO name:${NC} ")" name
  fi
  if [[ -z "$name" ]]; then
    echo -e "${RED}TODO name cannot be empty.${NC}" >&2
    return 1
  fi
  local sanitized_name=$(sanitize_filename "$name")
  if [[ "$sanitized_name" != "$name" ]]; then
    echo -e "${YELLOW}Using sanitized name:${NC} ${sanitized_name}"
  fi
  local file="${folder}/${sanitized_name}${DEFAULT_TODO_EXTENSION}"
  if [[ -f "$file" ]]; then
    echo -e "${YELLOW}TODO already exists:${NC} $file"
    read -r -p "$(echo -e "${YELLOW}Overwrite? (y/n):${NC} ")" confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
      echo -e "${YELLOW}Creation cancelled.${NC}"
      return 0
    fi
  fi
  if [[ -z "$priority" ]]; then
    priority=$(fzf_select "Select priority: " "${PRIORITIES[@]}")
    priority=${priority:-"None"}
  fi
  if [[ -z "$tags" ]]; then
    read -r -p "$(echo -e "${YELLOW}Enter tags (comma-separated, optional):${NC} ")" tags
  fi
  tags=$(echo "$tags" | sed 's/,/ /g' | tr ' ' '\n' | sort -u | tr '\n' ' ' | sed 's/ $//')
  local created_date
  created_date=$(date '+%Y-%m-%d %H:%M:%S')
  mkdir -p "$(dirname "$file")"
  cat > "$file" <<EOF
---
title: $sanitized_name
priority: $priority
tags: [$tags]
created: $created_date
status: active
---
# $sanitized_name

Add your TODO details here.
EOF
  tmux_edit "$file"
  echo -e "${GREEN}TODO created:${NC} $file"
}

list_todos() {
  local folder="$1"
  if [[ -z "$folder" ]]; then
    folder=$(select_project)
    if [[ -z "$folder" ]]; then
      echo -e "${YELLOW}No project selected.${NC}"
      return 1
    fi
  fi
  if [[ ! -d "$folder" ]]; then
    echo -e "${RED}Error: Project directory does not exist: ${folder}${NC}" >&2
    return 1
  fi
  local todos=()
  mapfile -t todos < <(find "$folder" -maxdepth 1 -type f -name "*${DEFAULT_TODO_EXTENSION}" -not -path "*/${ARCHIVE_FOLDER}/*" -exec sh -c 'basename {}' \; | sort)
  if [[ ${#todos[@]} -eq 0 ]]; then
    echo -e "${YELLOW}No active TODOs found in ${folder}.${NC}"
    return 0
  fi
  echo -e "${GREEN}Active TODOs in ${folder}:${NC}"
  for i in "${!todos[@]}"; do
    local todo_file="${folder}/${todos[$i]}"
    local title priority tags
    title=$(grep '^title:' "$todo_file" | sed 's/^title: //')
    priority=$(grep '^priority:' "$todo_file" | sed 's/^priority: //')
    tags=$(grep '^tags:' "$todo_file" | sed 's/^tags: \[//' | sed 's/\]//')
    printf "%2d. %s (Priority: %s, Tags: %s)\n" $((i+1)) "$title" "$priority" "$tags"
  done
}

open_todo() {
  local folder="$1"
  local todo_name="$2"
  if [[ -z "$folder" ]]; then
    folder=$(select_project)
    if [[ -z "$folder" ]]; then
      echo -e "${YELLOW}No project selected.${NC}"
      return 1
    fi
  fi
  if [[ ! -d "$folder" ]]; then
    echo -e "${RED}Error: Project directory does not exist: ${folder}${NC}" >&2
    return 1
  fi

  local todos=()
  mapfile -t todos < <(find "$folder" -maxdepth 1 -type f -name "*${DEFAULT_TODO_EXTENSION}" -not -path "*/${ARCHIVE_FOLDER}/*" -exec sh -c 'stat -c "%Y %n" {}' \; | sort -nr | cut -d' ' -f2-)
  if [[ ${#todos[@]} -eq 0 ]]; then
    echo -e "${YELLOW}No active TODOs found in ${folder}.${NC}"
    return 1
  fi

  local file
  if [[ -z "$todo_name" ]]; then
    file=$(basename "${todos[0]}")
    echo -e "${YELLOW}No TODO specified. Opening last modified TODO: ${file}${NC}"
  else
    if [[ "$todo_name" =~ ^[0-9]+$ ]] && [[ "$todo_name" -le ${#todos[@]} ]]; then
      file=$(basename "${todos[$((todo_name-1))]}")
    else
      file=$(printf "%s\n" "${todos[@]}" | grep -Fx "$todo_name${DEFAULT_TODO_EXTENSION}" || echo "")
    fi
  fi

  if [[ -z "$file" ]]; then
    echo -e "${RED}TODO not found.${NC}" >&2
    return 1
  fi
  tmux_edit "${folder}/${file}"
  echo -e "${GREEN}Opened TODO:${NC} ${file}"
}

