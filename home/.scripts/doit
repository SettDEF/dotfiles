search_todos() {
  local folder="$1"
  local keyword="$2"
  if [[ -z "$folder" ]]; then
    folder=$(select_project)
    if [[ -z "$folder" ]]; then
      echo -e "${YELLOW}No project selected.${NC}"
      return 1
    fi
  fi
  if [[ ! -d "$folder" ]]; then
    echo -e "${RED}Error: Project directory does not exist: ${folder}${NC}" >&2
    return 1
  fi
  if [[ -z "$keyword" ]]; then
    read -r -p "$(echo -e "${YELLOW}Enter search keyword:${NC} ")" keyword
  fi
  if [[ -z "$keyword" ]]; then
    echo -e "${RED}Search keyword cannot be empty.${NC}" >&2
    return 1
  fi
  local results=()
  mapfile -t results < <(grep -lir "$keyword" "$folder" --include="*${DEFAULT_TODO_EXTENSION}" --exclude-dir="${ARCHIVE_FOLDER}")
  if [[ ${#results[@]} -eq 0 ]]; then
    echo -e "${YELLOW}No TODOs found matching '${keyword}'.${NC}"
    return 0
  fi
  echo -e "${GREEN}TODOs matching '${keyword}':${NC}"
  for result in "${results[@]}"; do
    local title
    title=$(grep '^title:' "$result" | sed 's/^title: //')
    echo "- ${title} (${result})"
  done
}

search_todos_by_tags() {
  local folder="$1"
  local tags="$2"
  if [[ -z "$folder" ]]; then
    folder=$(select_project)
    if [[ -z "$folder" ]]; then
      echo -e "${YELLOW}No project selected.${NC}"
      return 1
    fi
  fi
  if [[ ! -d "$folder" ]]; then
    echo -e "${RED}Error: Project directory does not exist: ${folder}${NC}" >&2
    return 1
  fi
  if [[ -z "$tags" ]]; then
    read -r -p "$(echo -e "${YELLOW}Enter tags to search (comma-separated):${NC} ")" tags
  fi
  if [[ -z "$tags" ]]; then
    echo -e "${RED}Tags cannot be empty.${NC}" >&2
    return 1
  fi
  local tag_list
  tag_list=$(echo "$tags" | sed 's/,/ /g' | tr ' ' '\n' | sort -u)
  local results=()
  mapfile -t todos < <(find "$folder" -maxdepth 1 -type f -name "*${DEFAULT_TODO_EXTENSION}" -not -path "*/${ARCHIVE_FOLDER}/*")
  for todo in "${todos[@]}"; do
    local todo_tags
    todo_tags=$(grep '^tags:' "$todo" | sed 's/^tags: \[//' | sed 's/\]//' | tr ',' '\n' | sed 's/^[[:space:]]*//' | sort -u)
    local match=true
    for tag in $tag_list; do
      if ! echo "$todo_tags" | grep -Fx "$tag" > /dev/null; then
        match=false
        break
      fi
    done
    if $match; then
      results+=("$todo")
    fi
  done
  if [[ ${#results[@]} -eq 0 ]]; then
    echo -e "${YELLOW}No TODOs found with tags: ${tags}${NC}"
    return 0
  fi
  echo -e "${GREEN}TODOs with tags '${tags}':${NC}"
  for result in "${results[@]}"; do
    local title
    title=$(grep '^title:' "$result" | sed 's/^title: //')
    echo "- ${title} (${result})"
  done
}

