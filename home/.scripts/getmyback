    "$HOME/.config/redshift"
    "$HOME/.config/rofi"
    "$HOME/.config/surfraw"
    "$HOME/.config/systemd"
    "$HOME/.config/timewarrior"
    "$HOME/.config/tmux"
    "$HOME/.config/todo"
    "$HOME/.config/user-dirs.dirs"
    "$HOME/.config/vifm"
