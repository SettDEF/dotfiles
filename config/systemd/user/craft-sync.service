[Unit]
Description=Package new ArtCraft Crafting App releases into the local pacman repo
Documentation=file://%h/.scripts/apps/photocraft/craft-sync
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.scripts:%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=%h/.scripts/apps/photocraft/craft-sync
# Low priority: it only downloads and packages.
Nice=10
IOSchedulingClass=idle
