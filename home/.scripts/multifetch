# is_known DOMAIN FILE - the domain or any parent of it is listed
# (search.rlsbb.ru is rlsbb.ru).
is_known() {
    local d="$1"
    while [[ "$d" == *.*.* || "$d" == *.* ]]; do
        grep -qxF "$d" "$2" && return 0
        [[ "$d" == *.*.* ]] || return 1
        d="${d#*.}"
    done
    return 1
}

discover() {
    local add="$1" kw enc e cat site name tmpl url final host page hits=0
    mkdir -p "$DIR"
    local out="$DIR/scan-$(date +%Y-%m-%d-%H%M%S).tsv" prev posts domains known
    prev=$(mktemp); posts=$(mktemp); domains=$(mktemp); known=$(mktemp)
    trap 'rm -f "$prev" "$posts" "$domains" "$known"' RETURN
    cat "$DIR"/scan-*.tsv 2>/dev/null | cut -f3 | sort -u > "$prev"
    for e in "${SITES[@]}"; do echo "${e#*|}"; done | sort -u > "$known"
    for kw in "${KEYWORDS[@]}"; do
        enc="$(urlencode "$kw")"
        # The Pirate Bay's page is JavaScript; its JSON API is not.
        curl -s -A "$UA" --max-time 25 "https://apibay.org/q.php?q=$enc" \
            | jq -r '.[]? | select(.name != "No results returned") | "torrent\tThe Pirate Bay\thttps://thepiratebay.org/description.php?id=\(.id)\t\(.name)"' 2>/dev/null >> "$posts"
        # archive.org: people upload whole courses there; its search is JSON.
        curl -s -A "$UA" --max-time 25 "https://archive.org/advancedsearch.php?q=$enc&fl%5B%5D=identifier&fl%5B%5D=title&rows=100&output=json" \
            | jq -r '.response.docs[]? | "file-host\tarchive.org\thttps://archive.org/details/\(.identifier)\t\(.title // .identifier | if type=="array" then .[0] else . end)"' 2>/dev/null >> "$posts"
        for e in "${SEARCHABLE[@]}"; do
            cat="${e%%|*}"; site="${e#*|}"; name="${site%%|*}"; tmpl="${site#*|}"
            url="${tmpl//\{\}/$enc}"
            printf '\r  searching %-16s' "$name" >&2
            page=$(curl -sL -A "$UA" --max-time 25 -w '\n%{url_effective}' "$url") || continue
            final="${page##*$'\n'}"; page="${page%$'\n'*}"
            # A site that moved (freecoursesite -> fcsnew.net) is a new domain to watch.
            host=$(printf '%s' "$final" | awk -F/ '{print $3}' | sed 's/^www\.//')
            [[ -n "$host" ]] && ! is_known "$host" "$known" && printf '%s\t%s (redirect from %s)\n' "$host" "moved" "$name" >> "$domains"
            # Posts: links naming the keyword in their address or title. The
            # title is the link text, else a nested heading's title="" (AudioZ
            # wraps titles in <h2>, leaving the text empty), else the address
            # made readable. In-page "#" links (comments) and tag/search
            # pages are not posts.
            # One link per line first: a fixed-length grab ran into the next
            # link and swallowed it, losing posts listed close together.
            # Relative links (BitSearch's "/download/...") made absolute first.
            local base; base=$(printf '%s' "$final" | grep -oE '^https?://[^/]+')
            printf '%s' "$page" | tr '\n' ' ' | sed "s#href=\"/\([^/]\)#href=\"$base/\1#g" | sed 's/<a /\n<a /g' \
                | grep -iE '^<a [^>]*href="https?://[^"#]+"' | cut -c1-600 \
                | awk -v k="$kw" -v c="$cat" -v n="$name" '{
                    url = $0; sub(/^<a [^>]*href="/, "", url); sub(/".*/, "", url)
                    rest = $0; sub(/^<a [^>]*>/, "", rest)
                    t = rest; sub(/<.*/, "", t); gsub(/^ +| +$/, "", t)
                    if (t == "" && match(rest, /title="[^"]+"/)) t = substr(rest, RSTART + 7, RLENGTH - 8)
                    sub(/^Download /, "", t)
                    # Every word of the keyword, any order: "Schranz Production
                    # Course" matches "schranz course"; an exact phrase did not.
                    hay = tolower(url " " t); nw = split(tolower(k), w, /[ \t]+/); ok = 1
                    for (j = 1; j <= nw; j++) if (w[j] != "" && !index(hay, w[j])) { ok = 0; break }
                    if (!ok) next
                    # A post is linked several times (thumbnail, title, "read
                    # more"); keep the first non-empty title any of them gave.
                    if (!(url in title)) { order[++o] = url; title[url] = "" }
                    if (title[url] == "" && t != "") title[url] = t
                }
                END {
                    for (i = 1; i <= o; i++) {
                        u = order[i]; t = title[u]
                        if (t == "") { t = u; sub(/\/+$/, "", t); sub(/.*\//, "", t); sub(/\.html?$/, "", t); gsub(/[-_]/, " ", t) }
                        print c "\t" n "\t" u "\t" t
                    }
                }' >> "$posts"
            sleep 1
        done
    done
    echo >&2
    # Follow each post (up to 25) to the hosts it links to.
    sort -u -t$'\t' -k3,3 "$posts" | head -25 | while IFS=$'\t' read -r cat name url title; do
        curl -sL -A "$UA" --max-time 20 "$url" | grep -oE 'https?://[a-zA-Z0-9.-]+\.[a-z]{2,}' \
            | sed -E 's#https?://(www\.)?##' | sort -u \
            | while read -r d; do is_known "$d" "$known" || [[ "$url" == *"$d"* ]] || printf '%s\tlinked from %s\n' "$d" "$name"; done >> "$domains"
        sleep 1
    done
    # One rule for every source (the API ones included): all words of a
    # keyword in the title or address. archive.org also matches descriptions,
    # which pulled in sermons and parliamentary papers. Tor mirrors are skipped.
    local kws; kws=$(printf '%s\n' "${KEYWORDS[@]}")
    awk -F'\t' -v kws="$kws" 'BEGIN { nk = split(tolower(kws), K, "\n") }
        { hay = tolower($3 " " $4)
          for (i = 1; i <= nk; i++) { if (K[i] == "") continue
              nw = split(K[i], w, /[ \t]+/); ok = 1
              for (j = 1; j <= nw; j++) if (w[j] != "" && !index(hay, w[j])) { ok = 0; break }
              if (ok) { print; next } } }' "$posts" > "$posts.f" && mv "$posts.f" "$posts"

    # Report + record the posts like a scan, so --new work on them.
    local new=0
    while IFS=$'\t' read -r cat name url title; do
        hits=$((hits + 1)); flag=""
        grep -qxF "$url" "$prev" || { flag=NEW; new=$((new + 1)); }
        printf '%s\t%s\t%s\t%s\t%s\n' "$(date +%F)" "$cat" "$url" "$title" "$flag" >> "$out"
    done < <(sort -u -t$'\t' -k3,3 "$posts")
    if [[ "$hits" -gt 0 ]]; then
        echo "== $hits posts mention \"${KEYWORDS[*]}\" ($new new) -> $out"
        awk -F'\t' '{printf "  %s%-12s %s\n      %s\n", ($5=="NEW" ? "NEW " : "    "), $2, $4, $3}' "$out" | sed 's/&#8211;/-/g; s/&#038;/\&/g'
    else
        echo "== no posts mention \"${KEYWORDS[*]}\" on the searchable leak sites"
    fi
    local found=$hits
    if [[ -s "$domains" ]]; then
        echo "== domains seen in leaks but not in your site list (check before adding; stores show up too):"
        sort "$domains" | awk -F'\t' '{c[$1]++; w[$1]=$2} END {for (d in c) printf "  %-28s %3d x  %s\n", d, c[d], w[d]}' | sort -k2 -rn
        if [[ "$add" == 1 ]]; then
            mkdir -p "$(dirname "$SITES_FILE")"
            [[ -f "$SITES_FILE" ]] || printf '# Extra domains, one per line (without https://)\n' > "$SITES_FILE"
            cut -f1 "$domains" | sort -u | while read -r d; do
                grep -qxF "$d" "$SITES_FILE" || echo "$d   # discovered $(date +%F)" >> "$SITES_FILE"
            done
            echo "== added to $SITES_FILE (remove any legitimate stores with: multifetch -e)"
        else
            echo "   add them with: multifetch --discover --add \"${KEYWORDS[*]}\""
        fi
    fi
    (( found > 0 ))
}

if [[ "$MODE" == discover ]]; then
    DIR="$DATA_DIR/$(slug "${KEYWORDS[0]}")"
    discover "$ADD"
    exit $?
fi

# --- print: every search as "category<TAB>label<TAB>url", for scripts/pipes ----
if [[ "$MODE" == print || $OPEN == 1 ]]; then
    if (( OPEN )); then
        OPENER=xdg-open; command -v xdg-open >/dev/null || OPENER=open
        n=0
        while IFS=$'\t' read -r _ _ _ url; do "$OPENER" "$url" >/dev/null 2>&1 & n=$((n + 1)); sleep 0.8; done < <(searches)
        (( n > 0 )) && exit 0 || exit 1
    fi
    searches | awk -F'\t' '{print $1 "\t" $2 "\t" $4}' | emit && exit 0 || exit 1
fi

# --- pick: the original fzf flow, now grouped by category ----------------------
if [[ "$MODE" == pick ]]; then
    command -v fzf >/dev/null || die "fzf is required"
    OPENER=xdg-open; command -v xdg-open >/dev/null || OPENER=open
    if command -v wl-copy >/dev/null; then CLIP=wl-copy; elif command -v xclip >/dev/null; then CLIP="xclip -selection clipboard"; else CLIP="cat >/dev/null"; fi
    LINES=$(searches | awk -F'\t' '{
        c = $1; col = (c=="web") ? 34 : (c=="course-leak") ? 31 : (c=="audio-warez") ? 35 : (c=="torrent") ? 33 : (c=="file-host") ? 36 : (c=="telegram") ? 32 : (c=="platform") ? 94 : (c=="music-release") ? 95 : 37
        printf "\033[%dm%-12s\033[0m %s\t%s\n", col, c, $2, $4 }')
    while true; do
        sel="$(printf '%s\n' "$LINES" | fzf --ansi --multi --delimiter=$'\t' --with-nth=1 \
            --prompt="multifetch › " \
            --header="Enter open · Tab mark · Ctrl-A all · Ctrl-Y copy URL · Esc quit" \
            --preview='echo {2}' --preview-window=down,2,wrap \
            --bind="ctrl-a:select-all" --bind="ctrl-y:execute-silent(echo -n {2} | $CLIP)+bell")" || break
        while IFS=$'\t' read -r _ url; do
            [[ -n "$url" ]] && "$OPENER" "$url" >/dev/null 2>&1 &
            sleep 0.8
        done <<< "$sel"
    done
    exit 0
fi

# --- scan: every query through the Brave Search API ----------------------------
KEY_SLUG=$(slug "${KEYWORDS[0]}")
DIR="$DATA_DIR/$KEY_SLUG"

latest() { ls -1 "$DIR"/scan-*.tsv 2>/dev/null | tail -1; }

if [[ "$MODE" == scan ]]; then
    BRAVE_API_KEY="${BRAVE_API_KEY:-$(grep -E '^BRAVE_API_KEY=' "$KEYS_FILE" 2>/dev/null | cut -d= -f2- | tr -d '"'"'"'')}"
    # no Brave key: the searches run in your own browser (tela-zen agent tab, zen-search)
    if [[ -z "$BRAVE_API_KEY" ]]; then
        command -v zen-search >/dev/null || die "no BRAVE_API_KEY and no zen-search (tela-zen's agent control) to search with"
    fi
    mkdir -p "$DIR"
    out="$DIR/scan-$(date +%Y-%m-%d-%H%M).tsv"
    prev=$(mktemp); trap 'rm -f "$prev"' EXIT
    cat "$DIR"/scan-*.tsv 2>/dev/null | cut -f3 | sort -u > "$prev"
    queries=$(searches | awk -F'\t' '$3 != ""' )
    total=$(printf '%s\n' "$queries" | wc -l); n=0; hits=0; new=0
    match=$(printf '%s\n' "${KEYWORDS[@]}" | tr '[:upper:]' '[:lower:]' | paste -sd'|')
    if [[ -z "$BRAVE_API_KEY" ]]; then
        # all queries in one browser tab; each hit tagged with its query, matched back to its category
        declare -A CAT_OF
        while IFS=$'\t' read -r cat _ query _; do CAT_OF[$query]="$cat"; done <<< "$queries"
        echo "  searching $total queries in your browser (an agent tab)…" >&2
        while IFS=$'\t' read -r url title query; do
            [[ -n "$url" ]] || continue
            printf '%s %s' "$title" "$url" | tr '[:upper:]' '[:lower:]' | grep -qE "$match" || continue
            hits=$((hits + 1)); flag=""
            grep -qxF "$url" "$prev" || { flag=NEW; new=$((new + 1)); }
            printf '%s\t%s\t%s\t%s\t%s\n' "$(date +%F)" "${CAT_OF[$query]:-web}" "$url" "$title" "$flag" >> "$out"
        done < <(printf '%s\n' "$queries" | cut -f3 | zen-search -n 400)
    else
    while IFS=$'\t' read -r cat label query _; do
            n=$((n + 1)); printf '\r  %d/%d  %-60.60s' "$n" "$total" "$label" >&2
            resp=$(curl -s --max-time 20 -G "https://api.search.brave.com/res/v1/web/search" \
                -H "Accept: application/json" -H "X-Subscription-Token: $BRAVE_API_KEY" \
                --data-urlencode "q=$query" --data-urlencode "count=20")
            if printf '%s' "$resp" | jq -e '.type == "ErrorResponse"' >/dev/null 2>&1; then
                echo >&2; die "Brave API error: $(printf '%s' "$resp" | jq -r '.error.detail // .error.code')"
            fi
            # Keep only results that actually mention the keyword (title, URL or snippet).
            while IFS=$'\t' read -r url title; do
                [[ -n "$url" ]] || continue
                hits=$((hits + 1))
                flag=""; grep -qxF "$url" "$prev" || { flag="NEW"; new=$((new + 1)); }
                printf '%s\t%s\t%s\t%s\t%s\n' "$(date +%F)" "$cat" "$url" "$title" "$flag" >> "$out"
            done < <(printf '%s' "$resp" | jq -r --arg m "$match" '
                .web.results[]? | select(((.title // "") + " " + (.url // "") + " " + (.description // "")) | ascii_downcase | test($m))
                | [.url, (.title // "" | gsub("\t"; " "))] | @tsv' 2>/dev/null)
            sleep 1.1   # free tier: 1 request per second
        done <<< "$queries"
    fi
    echo >&2
    if [[ -f "$out" ]]; then
        sort -u -t$'\t' -k3,3 "$out" -o "$out"
        echo "$(wc -l < "$out") unique hits, $new new since earlier scans -> $out"
        (( QUIET )) || awk -F'\t' '$5=="NEW" {printf "  NEW  %-12s %s\n       %s\n", $2, $3, $4}' "$out"
        exit 0
    fi
    (( QUIET )) || echo "No hits for: ${KEYWORDS[*]}" >&2
    exit 1
fi

# --- new: what the latest scan found that no earlier one did -------------------
if [[ "$MODE" == new ]]; then
    f=$(latest); [[ -n "$f" ]] || die "no scans yet for \"${KEYWORDS[0]}\" - run: multifetch --scan \"${KEYWORDS[0]}\""
    awk -F'\t' '$5=="NEW" {print $2 "\t" $4 "\t" $3}' "$f" | emit && exit 0
    (( QUIET )) || echo "nothing new in $f" >&2
    exit 1
fi

    
