# tinct-generated theme for cmus
# Matches the active system wallpaper palette

# Background and text colors
set color_win_bg=default
set color_win_fg={{colors.on_surface.default.hex}}

# Directory and Category headers (views 1 and 2)
set color_win_dir={{colors.tertiary.default.hex}}

# Selected row (focused window)
set color_win_sel_bg={{colors.primary.default.hex}}
set color_win_sel_fg={{colors.on_primary.default.hex}}

# Selected row (unfocused window)
set color_win_inactive_sel_bg={{colors.surface_container_highest.default.hex}}
set color_win_inactive_sel_fg={{colors.on_surface.default.hex}}

# Currently playing track (unselected)
set color_win_cur={{colors.secondary.default.hex}}

# Currently playing track (selected)
set color_win_cur_sel_bg={{colors.primary.default.hex}}
set color_win_cur_sel_fg={{colors.on_primary.default.hex}}

# Inactive currently playing track (selected)
set color_win_inactive_cur_sel_bg={{colors.surface_container_highest.default.hex}}
set color_win_inactive_cur_sel_fg={{colors.secondary.default.hex}}

# Title line at the top
set color_titleline_bg={{colors.surface_container.default.hex}}
set color_titleline_fg={{colors.primary.default.hex}}

# Status line at the bottom
set color_statusline_bg={{colors.surface_container.default.hex}}
set color_statusline_fg={{colors.secondary.default.hex}}

# Command line / search input at the very bottom
set color_cmdline_bg={{colors.surface.default.hex}}
set color_cmdline_fg={{colors.on_surface.default.hex}}

# Warnings and errors
set color_error={{colors.error.default.hex}}
set color_info={{colors.secondary.default.hex}}

# Separator lines
set color_separator={{colors.surface_variant.default.hex}}
