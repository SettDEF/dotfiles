# paths.env: where this machine keeps big and personal folders. Scripts, zsh, Hyprland and the
# shell use these names, never a fixed path. The values for this machine go in
# ~/.config/paths.local.env (not shared); without it everything lives under your home.
#   STORAGE   a big data disk (builds, videos, downloads, backups)    default: $HOME
#   USERDATA  your own files on it (vault, wine prefixes, …)         default: $STORAGE
[ -f "$HOME/.config/paths.local.env" ] && . "$HOME/.config/paths.local.env"
export STORAGE="${STORAGE:-$HOME}"
export USERDATA="${USERDATA:-$STORAGE}"
export PROJECTS_DIR="${PROJECTS_DIR:-$STORAGE/dev/projects}"     # your source trees
export DEV_CACHE="${DEV_CACHE:-$STORAGE/dev-cache}"              # build caches, toolchains
export VIDEOS_DIR="${VIDEOS_DIR:-$STORAGE/Videos}"               # recordings, replays, FilmCraft
export DOWNLOADS_DIR="${DOWNLOADS_DIR:-$STORAGE/Downloads}"
export BACKUP_DIR="${BACKUP_DIR:-$STORAGE}"                      # system-backups/, home-mirror/, …
export PKG_REPO_DIR="${PKG_REPO_DIR:-$STORAGE/repo}"             # the local pacman repo
export ASSETS_DIR="${ASSETS_DIR:-$STORAGE/Assets}"
export VAULT_DIR="${VAULT_DIR:-$USERDATA/vault}"
export WINE_DIR="${WINE_DIR:-$USERDATA/wine}"
# builds and the npm cache on the data disk, only when there is one
if [ "$STORAGE" != "$HOME" ]; then
    export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$DEV_CACHE/targets}"
    export npm_config_cache="${npm_config_cache:-$DEV_CACHE/npm-cache}"
fi
