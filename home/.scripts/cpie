-- Utility Module --------------------------------------------------------------
local Utils = {}

function Utils.get_terminal_width()
	local handle = io.popen("tput cols 2>/dev/null || echo 80")
	local result = handle:read("*n")
	handle:close()
	return result or 80
end

function Utils.is_ansi_supported()
	local no_color = os.getenv("NO_COLOR")
	local term = os.getenv("TERM") or ""
	local colorterm = os.getenv("COLORTERM") or ""
	return not no_color
		and (
			term:match("xterm")
			or term:match("screen")
			or term:match("tmux")
			or term:match("linux")
			or term:match("color")
			or colorterm == "truecolor"
		)
end

function Utils.update_progress(message)
	if not os.getenv("QUIET") then
		io.write("\r" .. string.rep(" ", Utils.get_terminal_width()))
		io.write("\r" .. message)
		io.flush()
	end
end

function Utils.clear_progress()
	if not os.getenv("QUIET") then
		io.write("\r" .. string.rep(" ", Utils.get_terminal_width()) .. "\r")
		io.flush()
	end
end

function Utils.clamp(value, min_val, max_val)
	return math.max(min_val, math.min(max_val, value))
end

function Utils.round(value, decimals)
	local multiplier = 10 ^ (decimals or 0)
	return math.floor(value * multiplier + 0.5) / multiplier
end

-- String Class ----------------------------------------------------------------
local String = {}
String.__index = String

function String:new(str)
	return setmetatable({ value = tostring(str or "") }, self)
end

function String:__tostring()
	return self.value
end

function String:pad_right(width)
	local visible_length = #self.value:gsub("\27%[[%d;]*m", "")
	return self.value .. string.rep(" ", math.max(0, width - visible_length))
end

function String:colorize(fg_r, fg_g, fg_b, bg_r, bg_g, bg_b)
	if not Utils.is_ansi_supported() then
		return self
	end
	local colorterm = os.getenv("COLORTERM") or ""
	local colorized
	if colorterm == "truecolor" then
		-- Use truecolor (24-bit) ANSI codes
		colorized = string.format(
			"\27[38;2;%d;%d;%dm\27[48;2;%d;%d;%dm%s\27[0m",
			fg_r,
			fg_g,
			fg_b,
			bg_r,
			bg_g,
			bg_b,
			self.value
		)
	else
		-- Fallback to 256-color ANSI codes
		local function rgb_to_256(r, g, b)
			-- Approximate RGB to 256-color index
			r = math.floor((r / 255) * 5)
			g = math.floor((g / 255) * 5)
			b = math.floor((b / 255) * 5)
			return 16 + (36 * r) + (6 * g) + b
		end
		local fg_256 = rgb_to_256(fg_r, fg_g, fg_b)
		local bg_256 = rgb_to_256(bg_r, bg_g, bg_b)
		colorized = string.format("\27[38;5;%dm\27[48;5;%dm%s\27[0m", fg_256, bg_256, self.value)
	end
	return String:new(colorized)
end

function String:build_border(widths, border_type, chars, columns)
	local parts = { chars[border_type .. "_left"] or "" }
	for i, key in ipairs(columns) do
		if widths[key] then
			table.insert(parts, string.rep(chars.horizontal, widths[key] + 2))
			if i < #columns and widths[columns[i + 1]] then
				table.insert(parts, chars[border_type == "middle" and "separator" or border_type .. "_t"])
			end
		end
	end
	table.insert(parts, chars[border_type .. "_right"] or "")
	return table.concat(parts)
end

-- Color Module ----------------------------------------------------------------
local Color = {}

function Color.validate_hex(hex)
	if not hex then
		return false, "Hex color is required"
	end
	hex = hex:gsub("[\"']", ""):gsub("#", "")
	if #hex == 3 then
		hex = hex:gsub("(.)", "%1%1")
	elseif #hex ~= 6 then
		return false, "Invalid hex format: " .. hex .. ". Use #RRGGBB or #RGB"
	end
	if not hex:match("^[0-9A-Fa-f]+$") then
		return false, "Invalid hex characters in " .. hex .. ". Use 0-9, A-F only"
	end
	return true, "#" .. hex:upper()
end

function Color.hex_to_rgb(hex)
	local valid, normalized = Color.validate_hex(hex)
	if not valid then
		error(normalized)
	end
	hex = normalized:gsub("#", "")
	return tonumber(hex:sub(1, 2), 16), tonumber(hex:sub(3, 4), 16), tonumber(hex:sub(5, 6), 16)
end

function Color.rgb_to_hsl(r, g, b)
	r, g, b = r / 255, g / 255, b / 255
	local max, min = math.max(r, g, b), math.min(r, g, b)
	local h, s, l = 0, 0, (max + min) / 2

	if max ~= min then
		local d = max - min
		s = l > 0.5 and d / (2 - max - min) or d / (max + min)
		if max == r then
			h = (g - b) / d + (g < b and 6 or 0)
		elseif max == g then
			h = (b - r) / d + 2
		else
			h = (r - g) / d + 4
		end
		h = h / 6
	end
	return h, s, l
end

function Color.hsl_to_rgb(h, s, l)
	local r, g, b

	local function hue2rgb(p, q, t)
		if t < 0 then
			t = t + 1
		end
		if t > 1 then
			t = t - 1
		end
		if t < 1 / 6 then
			return p + (q - p) * 6 * t
		end
		if t < 1 / 2 then
			return q
		end
		if t < 2 / 3 then
			return p + (q - p) * (2 / 3 - t) * 6
		end
		return p
	end

	if s == 0 then
		r, g, b = l, l, l
	else
		local q = l < 0.5 and l * (1 + s) or l + s - l * s
		local p = 2 * l - q
		r = hue2rgb(p, q, h + 1 / 3)
		g = hue2rgb(p, q, h)
		b = hue2rgb(p, q, h - 1 / 3)
	end

	return Utils.round(r * 255), Utils.round(g * 255), Utils.round(b * 255)
end

function Color.rgb_to_hex(r, g, b)
	return string.format(
		"#%02X%02X%02X",
		Utils.clamp(Utils.round(r), 0, 255),
		Utils.clamp(Utils.round(g), 0, 255),
		Utils.clamp(Utils.round(b), 0, 255)
	)
end

function Color.hsl_to_string(h, s, l)
	return string.format(
		"H=%03.0f S=%02.0f%% L=%02.0f%%",
		Utils.round(h * 360),
		Utils.round(s * 100),
		Utils.round(l * 100)
	)
end

function Color.get_color_name(hex)
	local r, g, b = Color.hex_to_rgb(hex)

	for _, color in ipairs(Config.color_names) do
		if hex:upper() == color.hex then
			return color.name
		end
	end

	local closest_name = "Custom"
	local closest_distance = math.huge

	for _, color in ipairs(Config.color_names) do
		local nr, ng, nb = Color.hex_to_rgb(color.hex)
		local distance = math.sqrt((r - nr) ^ 2 + (g - ng) ^ 2 + (b - nb) ^ 2)
		if distance < closest_distance and distance <= color.threshold then
			closest_distance = distance
			closest_name = color.name
		end
	end

	return closest_name
end

function Color.get_lightness_category(l)
	if l < 0.4 then
		return "dark"
	elseif l <= 0.6 then
		return "medium"
	else
		return "light"
	end
end

function Color.get_contrast_text_color(r, g, b)
	local function to_linear(c)
		c = c / 255
		return c <= 0.03928 and c / 12.92 or ((c + 0.055) / 1.055) ^ 2.4
	end

	local luminance = 0.2126 * to_linear(r) + 0.7152 * to_linear(g) + 0.0722 * to_linear(b)
	return luminance > 0.179 and { 0, 0, 0 } or { 255, 255, 255 }
end

function Color.calculate_contrast_ratio(hex1, hex2)
	local function to_linear(c)
		c = c / 255
		return c <= 0.03928 and c / 12.92 or ((c + 0.055) / 1.055) ^ 2.4
	end

	local r1, g1, b1 = Color.hex_to_rgb(hex1)
	local r2, g2, b2 = Color.hex_to_rgb(hex2)

	local l1 = 0.2126 * to_linear(r1) + 0.7152 * to_linear(g1) + 0.0722 * to_linear(b1)
	local l2 = 0.2126 * to_linear(r2) + 0.7152 * to_linear(g2) + 0.0722 * to_linear(b2)

	return (math.max(l1, l2) + 0.05) / (math.min(l1, l2) + 0.05)
end

function Color.calculate_luminance(hex)
	local r, g, b = Color.hex_to_rgb(hex)
	local function to_linear(c)
		c = c / 255
		return c <= 0.03928 and c / 12.92 or ((c + 0.055) / 1.055) ^ 2.4
	end
	return Utils.round(0.2126 * to_linear(r) + 0.7152 * to_linear(g) + 0.0722 * to_linear(b), 3)
end

function Color.check_wcag_compliance(hex1, hex2)
	local contrast = Color.calculate_contrast_ratio(hex1, hex2)
	return {
		aa_normal = contrast >= 4.5 and "Pass" or "Fail",
		aa_large = contrast >= 3.0 and "Pass" or "Fail",
		aaa_normal = contrast >= 7.0 and "Pass" or "Fail",
		aaa_large = contrast >= 4.5 and "Pass" or "Fail",
		contrast = contrast,
	}
end

function Color.simulate_colorblind(hex, method)
	local r, g, b = Color.hex_to_rgb(hex)
	local sim_r, sim_g, sim_b

	if method == "protanopia" then
		sim_r, sim_g, sim_b = 0.56667 * r + 0.43333 * g, 0.55833 * r + 0.44167 * g, b
	elseif method == "deuteranopia" then
		sim_r, sim_g, sim_b = 0.625 * r + 0.375 * g, 0.7 * r + 0.3 * g, b
	elseif method == "tritanopia" then
		sim_r, sim_g, sim_b = r, g, 0.95 * r + 0.05 * g
	else
		return hex
	end

	return Color.rgb_to_hex(Utils.clamp(sim_r, 0, 255), Utils.clamp(sim_g, 0, 255), Utils.clamp(sim_b, 0, 255))
end

function Color.evaluate_foreground_effectiveness(fg_color, background_colors)
	local scores = { contrast = 0, luminance = 0, passing = 0 }

	for _, bg in ipairs(background_colors) do
		if bg.hex ~= fg_color.hex then
			local contrast = Color.calculate_contrast_ratio(fg_color.hex, bg.hex)
			local lum_diff = math.abs(Color.calculate_luminance(fg_color.hex) - Color.calculate_luminance(bg.hex))

			scores.contrast = scores.contrast + contrast
			scores.luminance = scores.luminance + lum_diff
			if contrast >= Config.fg_bg_test.min_contrast then
				scores.passing = scores.passing + 1
			end
		end
	end

	local count = #background_colors - 1
	local weights = Config.fg_bg_test.score_weights

	return {
		hex = fg_color.hex,
		name = fg_color.name,
		overall = Utils.round(
			(scores.contrast / count * weights.contrast)
				+ (scores.luminance / count * weights.luminance)
				+ (scores.passing / count * 100 * weights.versatility),
			2
		),
		contrast = Utils.round(scores.contrast / count, 2),
		luminance = Utils.round(scores.luminance / count, 2),
		versatility = Utils.round(scores.passing / count * 100, 1),
	}
end

function Color.generate_fg_bg_pairs(colors, options)
	options = options or {}
	local min_contrast = options.min_contrast or Config.fg_bg_test.min_contrast
	local pairs = {}

	for _, fg in ipairs(colors) do
		for _, bg in ipairs(colors) do
			if fg.hex ~= bg.hex then
				local contrast = Color.calculate_contrast_ratio(fg.hex, bg.hex)
				if contrast >= min_contrast then
					table.insert(pairs, {
						foreground = fg,
						background = bg,
						contrast = Utils.round(contrast, 2),
						passed = true,
					})
				end
			end
		end
	end

	return pairs
end

-- Palette Module --------------------------------------------------------------
local Palette = {}

function Palette.generate_lightness(hex, count, verbose)
	local verbose_output = {}
	local r, g, b = Color.hex_to_rgb(hex)
	local h, s, l = Color.rgb_to_hsl(r, g, b)

	if verbose then
		table.insert(verbose_output, "[verbose] Algorithm: Lightness Variations")
		table.insert(verbose_output, "[verbose] Input: " .. hex)
		table.insert(verbose_output, "[verbose] HSL: " .. Color.hsl_to_string(h, s, l))
	end

	local step = Config.palette_methods.lightness.step
	local k = math.floor((count - 1) / 2)
	local colors = {}

	for i = -k, k do
		local delta = i * step
		local l_new = Utils.clamp(l + delta, 0, 1)
		local r2, g2, b2 = Color.hsl_to_rgb(h, s, l_new)
		local hex2 = Color.rgb_to_hex(r2, g2, b2)

		if verbose then
			table.insert(verbose_output, string.format("[verbose] Step %d: L=%.3f -> %s", i, l_new, hex2))
		end

		table.insert(colors, {
			hex = hex2,
			r = r2,
			g = g2,
			b = b2,
			h = h,
			s = s,
			l = l_new,
			name = Color.get_color_name(hex2),
			lightness = Color.get_lightness_category(l_new),
			role = i == 0 and "primary" or (i == 1 or i == -1) and "secondary" or "accent",
		})
	end

	if verbose and #verbose_output > 0 then
		print(table.concat(verbose_output, "\n"))
	end
	return colors, "Lightness Variations"
end

function Palette.generate_saturation(hex, count, verbose)
	local r, g, b = Color.hex_to_rgb(hex)
	local h, s, l = Color.rgb_to_hsl(r, g, b)

	local step = Config.palette_methods.saturation.step
	local k = math.floor((count - 1) / 2)
	local colors = {}

	for i = -k, k do
		local delta = i * step
		local s_new = Utils.clamp(s + delta, 0, 1)
		local r2, g2, b2 = Color.hsl_to_rgb(h, s_new, l)
		local hex2 = Color.rgb_to_hex(r2, g2, b2)

		table.insert(colors, {
			hex = hex2,
			r = r2,
			g = g2,
			b = b2,
			h = h,
			s = s_new,
			l = l,
			name = Color.get_color_name(hex2),
			lightness = Color.get_lightness_category(l),
			role = i == 0 and "primary" or (i == 1 or i == -1) and "secondary" or "accent",
		})
	end

	return colors, "Saturation Variations"
end

function Palette.generate_hue(hex, count, verbose)
	local r, g, b = Color.hex_to_rgb(hex)
	local h, s, l = Color.rgb_to_hsl(r, g, b)
	s = Config.palette_methods.hue.saturation -- Fixed saturation at 85%

	local step = Config.palette_methods.hue.step / 360
	local k = math.floor((count - 1) / 2)
	local colors = {}

	local hue_adjustments = { -60, -30, 0, 30, 60 }
	for i = -k, k do
		local delta = (hue_adjustments[i + k + 1] or (i * step * 360)) / 360
		local h_new = (h + delta) % 1
		if h_new < 0 then
			h_new = h_new + 1
		end
		local r2, g2, b2 = Color.hsl_to_rgb(h_new, s, l)
		local hex2 = Color.rgb_to_hex(r2, g2, b2)

		table.insert(colors, {
			hex = hex2,
			r = r2,
			g = g2,
			b = b2,
			h = h_new,
			s = s,
			l = l,
			name = Color.get_color_name(hex2),
			lightness = Color.get_lightness_category(l),
			role = i == 0 and "primary" or (i == 1 or i == -1) and "secondary" or "accent",
		})
	end

	return colors, "Hue Variations"
end

function Palette.generate_complementary(hex, count, verbose)
	local r, g, b = Color.hex_to_rgb(hex)
	local h, s, l = Color.rgb_to_hsl(r, g, b)
	local colors = {}

	table.insert(colors, {
		hex = hex,
		r = r,
		g = g,
		b = b,
		h = h,
		s = s,
		l = l,
		name = Color.get_color_name(hex),
		lightness = Color.get_lightness_category(l),
		role = "primary",
	})

	local h_comp = (h + 0.5) % 1
	local r2, g2, b2 = Color.hsl_to_rgb(h_comp, s, l)
	local hex2 = Color.rgb_to_hex(r2, g2, b2)

	table.insert(colors, {
		hex = hex2,
		r = r2,
		g = g2,
		b = b2,
		h = h_comp,
		s = s,
		l = l,
		name = Color.get_color_name(hex2),
		lightness = Color.get_lightness_category(l),
		role = "complement",
	})

	while #colors < count do
		local base_idx = (#colors % 2) + 1
		local base_color = colors[base_idx]
		local l_var = base_color.l + (0.2 * (#colors - 2))
		l_var = Utils.clamp(l_var, 0, 1)

		local r3, g3, b3 = Color.hsl_to_rgb(base_color.h, base_color.s, l_var)
		local hex3 = Color.rgb_to_hex(r3, g3, b3)

		table.insert(colors, {
			hex = hex3,
			r = r3,
			g = g3,
			b = b3,
			h = base_color.h,
			s = base_color.s,
			l = l_var,
			name = Color.get_color_name(hex3),
			lightness = Color.get_lightness_category(l_var),
			role = base_idx == 1 and "primary" or "complement",
		})
	end

	return colors, "Complementary Colors"
end

function Palette.generate_triadic(hex, count, verbose)
	local r, g, b = Color.hex_to_rgb(hex)
	local h, s, l = Color.rgb_to_hsl(r, g, b)
	local colors = {}
	local base_colors = {}
	local base_hues = { h, (h + 1 / 3) % 1, (h + 2 / 3) % 1 }

	for i = 1, 3 do
		local h_new = base_hues[i]
		local r_new, g_new, b_new = Color.hsl_to_rgb(h_new, s, l)
		local hex_new = Color.rgb_to_hex(r_new, g_new, b_new)
		table.insert(base_colors, {
			hex = hex_new,
			r = r_new,
			g = g_new,
			b = b_new,
			h = h_new,
			s = s,
			l = l,
			name = Color.get_color_name(hex_new),
			lightness = Color.get_lightness_category(l),
			role = i == 1 and "primary" or (i == 2 and "secondary" or "accent"),
		})
	end

	for i = 1, math.min(count, #base_colors) do
		table.insert(colors, base_colors[i])
	end

	local variation_count = 1
	while #colors < count do
		local base_idx = ((#colors - 1) % 3) + 1
		local base_color = base_colors[base_idx]
		local l_delta = (variation_count % 2 == 1 and 1 or -1) * 0.15 * math.ceil(variation_count / 2)
		local l_new = Utils.clamp(base_color.l + l_delta, 0, 1)
		local r3, g3, b3 = Color.hsl_to_rgb(base_color.h, base_color.s, l_new)
		local hex3 = Color.rgb_to_hex(r3, g3, b3)
		local is_duplicate = false

		for _, c in ipairs(colors) do
			if c.hex == hex3 then
				is_duplicate = true
				break
			end
		end

		if not is_duplicate then
			table.insert(colors, {
				hex = hex3,
				r = r3,
				g = g3,
				b = b3,
				h = base_color.h,
				s = base_color.s,
				l = l_new,
				name = Color.get_color_name(hex3),
				lightness = Color.get_lightness_category(l_new),
				role = base_idx == 1 and "primary" or (base_idx == 2 and "secondary" or "accent"),
			})
		end
		variation_count = variation_count + 1
		if variation_count > 20 then
			break
		end
	end

	return colors, "Triadic Colors"
end

function Palette.generate_analogous(hex, count, verbose)
	local r, g, b = Color.hex_to_rgb(hex)
	local h, s, l = Color.rgb_to_hsl(r, g, b)

	local step = (Config.palette_methods.analogous.step or 25) / 360
	local k = math.floor((count - 1) / 2)
	local colors = {}

	for i = -k, k do
		local delta = i * step
		local h_new = (h + delta)
		if h_new < 0 then
			h_new = h_new + 1
		end
		h_new = h_new % 1

		local r2, g2, b2 = Color.hsl_to_rgb(h_new, s, l)
		local hex2 = Color.rgb_to_hex(r2, g2, b2)

		table.insert(colors, {
			hex = hex2,
			r = r2,
			g = g2,
			b = b2,
			h = h_new,
			s = s,
			l = l,
			name = Color.get_color_name(hex2),
			lightness = Color.get_lightness_category(l),
			role = i == 0 and "primary" or (i == 1 or i == -1) and "secondary" or "accent",
		})
	end

	return colors, "Analogous Colors"
end

function Palette.generate_blend(hex1, hex2, count, verbose)
	local verbose_output = {}
	local r1, g1, b1 = Color.hex_to_rgb(hex1)
	local r2, g2, b2 = Color.hex_to_rgb(hex2)

	if verbose then
		table.insert(verbose_output, "[verbose] Algorithm: Blended Colors")
		table.insert(
			verbose_output,
			"[verbose] Input Color 1: " .. hex1 .. " (RGB: " .. r1 .. "," .. g1 .. "," .. b1 .. ")"
		)
		table.insert(
			verbose_output,
			"[verbose] Input Color 2: " .. hex2 .. " (RGB: " .. r2 .. "," .. g2 .. "," .. b2 .. ")"
		)
	end

	local colors = {}
	for i = 0, count - 1 do
		local t = i / (count - 1)
		local r = Utils.round(r1 + (r2 - r1) * t)
		local g = Utils.round(g1 + (g2 - g1) * t)
		local b = Utils.round(b1 + (b2 - b1) * t)
		local hex = Color.rgb_to_hex(r, g, b)
		local h, s, l = Color.rgb_to_hsl(r, g, b)

		if verbose then
			table.insert(
				verbose_output,
				string.format("[verbose] Step %d: t=%.3f, RGB=(%d,%d,%d), Hex=%s", i, t, r, g, b, hex)
			)
		end

		table.insert(colors, {
			hex = hex,
			r = r,
			g = g,
			b = b,
			h = h,
			s = s,
			l = l,
			name = Color.get_color_name(hex),
			lightness = Color.get_lightness_category(l),
			role = i == 0 and "primary" or (i == count - 1 and "secondary" or "accent"),
		})
	end

	if verbose and #verbose_output > 0 then
		print(table.concat(verbose_output, "\n"))
	end
	return colors, "Blended Colors"
end

function Palette.generate_blended_palette(hex1, hex2, ratio, verbose)
	local verbose_output = {}
	local r1, g1, b1 = Color.hex_to_rgb(hex1)
	local r2, g2, b2 = Color.hex_to_rgb(hex2)

	if verbose then
		table.insert(verbose_output, "[verbose] Algorithm: Blended Palette")
		table.insert(
			verbose_output,
			"[verbose] Input Color 1: " .. hex1 .. " (RGB: " .. r1 .. "," .. g1 .. "," .. b1 .. ")"
		)
		table.insert(
			verbose_output,
			"[verbose] Input Color 2: " .. hex2 .. " (RGB: " .. r2 .. "," .. g2 .. "," .. b2 .. ")"
		)
		table.insert(verbose_output, "[verbose] Blend Ratio: " .. ratio)
	end

	local r = Utils.round(r1 + (r2 - r1) * ratio)
	local g = Utils.round(g1 + (g2 - g1) * ratio)
	local b = Utils.round(b1 + (b2 - b1) * ratio)
	local hex = Color.rgb_to_hex(r, g, b)
	local h, s, l = Color.rgb_to_hsl(r, g, b)

	if verbose then
		table.insert(
			verbose_output,
			string.format("[verbose] Blended: t=%.3f, RGB=(%d,%d,%d), Hex=%s", ratio, r, g, b, hex)
		)
	end

	local colors = {
		{
			hex = hex,
			r = r,
			g = g,
			b = b,
			h = h,
			s = s,
			l = l,
			name = Color.get_color_name(hex),
			lightness = Color.get_lightness_category(l),
			role = "primary",
		},
	}

	if verbose and #verbose_output > 0 then
		print(table.concat(verbose_output, "\n"))
	end
	return colors, "Blended Palette"
end

-- Display Module --------------------------------------------------------------
local Display = {}

function Display.calculate_column_widths(term_width, show_names, test_method, is_test_table, show_swatch)
	local columns = is_test_table and { "hex" } or { "hex", "rgb", "hsl" }
	if show_names and not is_test_table then
		table.insert(columns, 4, "name")
	end
	if show_swatch and not is_test_table then
		table.insert(columns, "swatch")
	end

	if is_test_table then
		if test_method == "contrast" then
			table.insert(columns, "contrast_white")
			table.insert(columns, "contrast_black")
		elseif test_method == "colorblind" then
			table.insert(columns, "protanopia")
			table.insert(columns, "deuteranopia")
			table.insert(columns, "tritanopia")
		elseif test_method == "wcag" then
			table.insert(columns, "wcag_aa")
			table.insert(columns, "wcag_aaa")
		elseif test_method == "luminance" then
			table.insert(columns, "luminance")
		elseif test_method == "foreground" then
			table.insert(columns, "fg_score")
			table.insert(columns, "fg_contrast")
			table.insert(columns, "fg_versatility")
		end
	end

	local widths = {}
	local total_min = #columns - 1
	for _, col in ipairs(columns) do
		widths[col] = Config.min_col_widths[col]
		total_min = total_min + widths[col]
	end

	local extra = math.max(total_min, term_width) - total_min
	local expandable = is_test_table
			and {
				"contrast_white",
				"contrast_black",
				"protanopia",
				"deuteranopia",
				"tritanopia",
				"wcag_aa",
				"wcag_aaa",
				"luminance",
				"fg_score",
				"fg_contrast",
				"fg_versatility",
			}
		or { "swatch", "name", "hsl" }

	for _, col in ipairs(expandable) do
		if widths[col] and extra > 0 then
			local add = math.min(Config.max_col_widths[col] - widths[col], extra)
			widths[col] = widths[col] + add
			extra = extra - add
		end
	end

	return widths, columns
end

function Display.palette_table(colors, palette_name, show_names, show_swatch)
	local term_width = Utils.get_terminal_width()
	local widths, columns = Display.calculate_column_widths(term_width, show_names, nil, false, show_swatch)
	local output, s, bc = {}, String:new(), Config.border_chars

	table.insert(output, s:build_border(widths, "top", bc, columns))
	local header_text = " " .. palette_name
	local total_inner_width = 0
	for i, key in ipairs(columns) do
		total_inner_width = total_inner_width + widths[key] + 2
	end
	total_inner_width = total_inner_width + (#columns - 1)
	table.insert(output, bc.vertical .. tostring(String:new(header_text):pad_right(total_inner_width)) .. bc.vertical)
	table.insert(output, s:build_border(widths, "middle", bc, columns))

	local header_labels = {
		hex = " Hex",
		rgb = " RGB",
		hsl = " HSL",
		name = " Name",
		swatch = " Swatch",
	}
	local header_row = {}
	table.insert(header_row, bc.vertical)
	for i, key in ipairs(columns) do
		local padded_header = String:new(" " .. header_labels[key] .. " "):pad_right(widths[key] + 2)
		table.insert(header_row, tostring(padded_header))
		if i < #columns then
			table.insert(header_row, bc.vertical)
		end
	end
	table.insert(header_row, bc.vertical)
	table.insert(output, table.concat(header_row))
	table.insert(output, s:build_border(widths, "middle", bc, columns))

	for _, color in ipairs(colors) do
		local row_parts = {}
		table.insert(row_parts, bc.vertical)

		local hex_cell = String:new(" " .. color.hex .. " "):pad_right(widths.hex + 2)
		table.insert(row_parts, tostring(hex_cell))
		table.insert(row_parts, bc.vertical)

		local rgb_text = string.format("%3d,%3d,%3d", color.r, color.g, color.b)
		local rgb_cell = String:new(" " .. rgb_text .. " "):pad_right(widths.rgb + 2)
		table.insert(row_parts, tostring(rgb_cell))
		table.insert(row_parts, bc.vertical)

		local hsl_text = Color.hsl_to_string(color.h, color.s, color.l)
		local hsl_cell = String:new(" " .. hsl_text .. " "):pad_right(widths.hsl + 2)
		table.insert(row_parts, tostring(hsl_cell))
		table.insert(row_parts, bc.vertical)

		if show_names and widths.name then
			local name_cell = String:new(" " .. color.name .. " "):pad_right(widths.name + 2)
			table.insert(row_parts, tostring(name_cell))
			table.insert(row_parts, bc.vertical)
		end

		if show_swatch and widths.swatch then
			local swatch_text = string.rep("█", widths.swatch)
			local swatch = String:new(swatch_text)
			if Utils.is_ansi_supported() then
				local fg = Color.get_contrast_text_color(color.r, color.g, color.b)
				swatch = String:new(swatch_text):colorize(fg[1], fg[2], fg[3], color.r, color.g, color.b)
			end
			local swatch_cell = " " .. tostring(swatch) .. " "
			table.insert(row_parts, String:new(swatch_cell):pad_right(widths.swatch + 2))
			table.insert(row_parts, bc.vertical)
		end

		table.insert(output, table.concat(row_parts))
	end

	table.insert(output, s:build_border(widths, "bottom", bc, columns))
	Utils.clear_progress()
	print(table.concat(output, "\n"))
end

function Display.test_table(colors, test_method)
	local term_width = Utils.get_terminal_width()
	local widths, columns = Display.calculate_column_widths(term_width, false, test_method, true, false)
	local output, s, bc = {}, String:new(), Config.border_chars

	local title = test_method == "contrast" and "Contrast Ratios"
		or test_method == "colorblind" and "Colorblind Simulations"
		or test_method == "wcag" and "WCAG Compliance"
		or test_method == "luminance" and "Luminance Values"
		or test_method == "foreground" and "Foreground Effectiveness"

	table.insert(output, s:build_border(widths, "top", bc, columns))
	local total_inner_width = 0
	for i, key in ipairs(columns) do
		total_inner_width = total_inner_width + widths[key] + 2
	end
	total_inner_width = total_inner_width + (#columns - 1)
	table.insert(output, bc.vertical .. tostring(String:new(" " .. title):pad_right(total_inner_width)) .. bc.vertical)
	table.insert(output, s:build_border(widths, "middle", bc, columns))

	local header_labels = {
		hex = " Hex",
		contrast_white = " vs White",
		contrast_black = " vs Black",
		protanopia = " Protanopia",
		deuteranopia = " Deuteranopia",
		tritanopia = " Tritanopia",
		wcag_aa = " WCAG AA",
		wcag_aaa = " WCAG AAA",
		luminance = " Luminance",
		fg_score = " Score",
		fg_contrast = " Contrast",
		fg_versatility = " Versatility",
	}
	local header_row = {}
	table.insert(header_row, bc.vertical)
	for i, key in ipairs(columns) do
		local padded_header = String:new(" " .. header_labels[key] .. " "):pad_right(widths[key] + 2)
		table.insert(header_row, tostring(padded_header))
		if i < #columns then
			table.insert(header_row, bc.vertical)
		end
	end
	table.insert(header_row, bc.vertical)
	table.insert(output, table.concat(header_row))
	table.insert(output, s:build_border(widths, "middle", bc, columns))

	for _, color in ipairs(colors) do
		local row_parts = {}
		table.insert(row_parts, bc.vertical)

		local hex_cell = String:new(" " .. color.hex .. " "):pad_right(widths.hex + 2)
		table.insert(row_parts, tostring(hex_cell))
		table.insert(row_parts, bc.vertical)

		if test_method == "contrast" then
			local function colorize_contrast(ratio)
				local ratio_str = string.format(" %.2f", ratio)
				if not Utils.is_ansi_supported() then
					return ratio_str
				end
				local color_code
				if ratio >= 7.0 then
					color_code = "\27[32m" -- Green for AAA
				elseif ratio >= 4.5 then
					color_code = "\27[33m" -- Yellow for AA
				else
					color_code = "\27[31m" -- Red for Fail
				end
				return color_code .. ratio_str .. "\27[0m"
			end

			local cr_white = Color.calculate_contrast_ratio(color.hex, "#FFFFFF")
			local cr_black = Color.calculate_contrast_ratio(color.hex, "#000000")
			local white_cell = String:new(colorize_contrast(cr_white)):pad_right(widths.contrast_white + 2)
			local black_cell = String:new(colorize_contrast(cr_black)):pad_right(widths.contrast_black + 2)
			table.insert(row_parts, tostring(white_cell))
			table.insert(row_parts, bc.vertical)
			table.insert(row_parts, tostring(black_cell))
			table.insert(row_parts, bc.vertical)
		elseif test_method == "colorblind" then
			local function create_colorblind_cell(hex, width)
				local content = " " .. hex .. " "
				local cell
				if Utils.is_ansi_supported() then
					local r, g, b = Color.hex_to_rgb(hex)
					local fg = Color.get_contrast_text_color(r, g, b)
					cell = String:new(content):colorize(fg[1], fg[2], fg[3], r, g, b)
				else
					cell = String:new(content)
				end
				return cell:pad_right(width + 2)
			end

			local prot_hex = Color.simulate_colorblind(color.hex, "protanopia")
			local deut_hex = Color.simulate_colorblind(color.hex, "deuteranopia")
			local trit_hex = Color.simulate_colorblind(color.hex, "tritanopia")

			table.insert(row_parts, create_colorblind_cell(prot_hex, widths.protanopia))
			table.insert(row_parts, bc.vertical)
			table.insert(row_parts, create_colorblind_cell(deut_hex, widths.deuteranopia))
			table.insert(row_parts, bc.vertical)
			table.insert(row_parts, create_colorblind_cell(trit_hex, widths.tritanopia))
			table.insert(row_parts, bc.vertical)
		elseif test_method == "wcag" then
			local function colorize_wcag_text(text)
				if not Utils.is_ansi_supported() then
					return text
				end
				return text:gsub("Pass", "\27[32mPass\27[0m"):gsub("Fail", "\27[31mFail\27[0m")
			end

			local wcag_white = Color.check_wcag_compliance(color.hex, "#FFFFFF")
			local aa_text = colorize_wcag_text(wcag_white.aa_normal .. "/" .. wcag_white.aa_large)
			local aaa_text = colorize_wcag_text(wcag_white.aaa_normal .. "/" .. wcag_white.aaa_large)
			local aa_cell = String:new(" " .. aa_text .. " "):pad_right(widths.wcag_aa + 2)
			local aaa_cell = String:new(" " .. aaa_text .. " "):pad_right(widths.wcag_aaa + 2)
			table.insert(row_parts, tostring(aa_cell))
			table.insert(row_parts, bc.vertical)
			table.insert(row_parts, tostring(aaa_cell))
			table.insert(row_parts, bc.vertical)
		elseif test_method == "luminance" then
			local lum = Color.calculate_luminance(color.hex)
			local lum_cell = String:new(string.format(" %.3f", lum)):pad_right(widths.luminance + 2)
			table.insert(row_parts, tostring(lum_cell))
			table.insert(row_parts, bc.vertical)
		elseif test_method == "foreground" then
			local score = Color.evaluate_foreground_effectiveness(color, colors)
			local score_cell = String:new(" " .. score.overall):pad_right(widths.fg_score + 2)
			local contrast_cell = String:new(" " .. score.contrast):pad_right(widths.fg_contrast + 2)
			local versatility_cell = String:new(" " .. score.versatility .. "%"):pad_right(widths.fg_versatility + 2)
			table.insert(row_parts, tostring(score_cell))
			table.insert(row_parts, bc.vertical)
			table.insert(row_parts, tostring(contrast_cell))
			table.insert(row_parts, bc.vertical)
			table.insert(row_parts, tostring(versatility_cell))
			table.insert(row_parts, bc.vertical)
		end

		table.insert(output, table.concat(row_parts))
	end

	table.insert(output, s:build_border(widths, "bottom", bc, columns))
	print(table.concat(output, "\n"))
end

function Display.show_foreground_matrix(colors)
	local sample_text = Config.fg_bg_test.sample_text
	local sample_width = Config.fg_bg_test.sample_width
	local heatmap = Config.fg_bg_test.heatmap
	local term_width = Utils.get_terminal_width()

	local col_width = math.max(8, math.floor((term_width - 10) / (#colors + 1)))

	local header = { "FG \\ BG" }
	for _, bg in ipairs(colors) do
		table.insert(header, String:new(bg.hex):pad_right(col_width))
	end
	print(table.concat(header, " | "))

	for _, fg in ipairs(colors) do
		local row = { String:new(fg.hex):pad_right(8) }
		local fg_r, fg_g, fg_b = Color.hex_to_rgb(fg.hex)

		for _, bg in ipairs(colors) do
			local bg_r, bg_g, bg_b = Color.hex_to_rgb(bg.hex)
			local contrast = Color.calculate_contrast_ratio(fg.hex, bg.hex)

			local sample = String:new(sample_text):colorize(fg_r, fg_g, fg_b, bg_r, bg_g, bg_b):pad_right(sample_width)

			local contrast_str = string.format("%.1f", contrast)
			if Utils.is_ansi_supported() then
				local heat_color
				if contrast < heatmap.poor.threshold then
					heat_color = heatmap.poor.color
				elseif contrast < heatmap.fair.threshold then
					heat_color = heatmap.fair.color
				elseif contrast < heatmap.good.threshold then
					heat_color = heatmap.good.color
				else
					heat_color = heatmap.excellent.color
				end
				contrast_str = string.format(
					"\27[38;2;%d;%d;%dm%s\27[0m",
					heat_color[1],
					heat_color[2],
					heat_color[3],
					contrast_str
				)
			end

			table.insert(row, String:new(sample .. " " .. contrast_str):pad_right(col_width))
		end

		print(table.concat(row, " | "))
	end

	print("\nLegend:")
