[Unit]
Description=KinetiX Mouse Motion Physics Daemon
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=/home/caesar/.scripts/apps/knurl/kinetix --daemon
Restart=always
RestartSec=3
Environment=PATH=/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
