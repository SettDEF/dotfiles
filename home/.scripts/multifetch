MODE="" IPTV=0 ADD=0 FORMAT=table HEADER=1 QUIET=0 COLOR=auto SPLIT=0 OPEN=0 MAX=0
CATS=() WORDS=() FILES=() KEYWORDS_IN=()
need_arg() { [[ $# -ge 2 && -n "$2" ]] || die "option $1 needs an argument (see multifetch -h)"; }
# one short option without an argument; false when it is not one
flag() {
    case "$1" in
        h) usage; exit 0 ;;          V) echo "multifetch $VERSION"; exit 0 ;;
        p) MODE=print ;;             s) MODE=scan ;;          n) MODE=new ;;
        d) MODE=discover ;;          a) ADD=1 ;;              i) IPTV=1 ;;
        l) MODE=sites ;;             e) MODE=edit ;;          u) FORMAT=urls ;;
        j) FORMAT=json ;;            H) HEADER=0 ;;           q) QUIET=1 ;;
        o) OPEN=1 ;;                 w) SPLIT=1 ;;            C) FORMAT=count ;;
        *) return 1 ;;
    esac
}
while [[ $# -gt 0 ]]; do
    a="$1"
    case "$a" in
        --) shift; WORDS+=("$@"); break ;;
        --help) flag h ;;      --version) flag V ;;   --print) flag p ;;   --scan) flag s ;;
        --new) flag n ;;       --discover) flag d ;;  --add) flag a ;;     --iptv) flag i ;;
        --sites) flag l ;;     --edit) flag e ;;      --urls) flag u ;;    --json) flag j ;;
        --no-header) flag H ;; --quiet) flag q ;;     --open) flag o ;;    --words) flag w ;;
        --count) flag C ;;
        -m|--max) need_arg "$@"; MAX="$2"; shift ;;
        --max=*) MAX="${a#*=}" ;;
        --color|--colour) COLOR=always ;;
        --color=*|--colour=*) COLOR="${a#*=}" ;;
        -c|--category) need_arg "$@"; IFS=, read -ra c <<< "$2"; CATS+=("${c[@]}"); shift ;;
        --category=*) IFS=, read -ra c <<< "${a#*=}"; CATS+=("${c[@]}") ;;
        -f|--file) need_arg "$@"; FILES+=("$2"); shift ;;
        --file=*) FILES+=("${a#*=}") ;;
        --*) die "unknown option $a (see multifetch -h)" ;;
        -?*)
            # short options, bundled: -pu, -pctorrent, -pc torrent
            rest="${a#-}"
            while [[ -n "$rest" ]]; do
                o="${rest:0:1}"; rest="${rest:1}"
                if [[ "$o" == c || "$o" == f || "$o" == m ]]; then
                    val="$rest"; rest=""
                    if [[ -z "$val" ]]; then need_arg "-$o" "${2:-}"; val="$2"; shift; fi
                    case "$o" in c) IFS=, read -ra c <<< "$val"; CATS+=("${c[@]}") ;; f) FILES+=("$val") ;; m) MAX="$val" ;; esac
                else
                    flag "$o" || die "unknown option -$o (see multifetch -h)"
                fi
            done ;;
        *) WORDS+=("$a") ;;
    esac
    shift
done
