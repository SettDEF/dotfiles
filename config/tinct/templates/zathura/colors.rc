# Auto-generated by tinct. Do not edit — edit the template instead:
#   ~/.config/tinct/templates/zathura/colors.rc
#
# Pulled in from zathurarc via `include colors.rc`, which is placed AFTER the
# hand-written settings there. zathura applies directives in order and the last
# one wins, so these override the literals above without anything needing to be
# deleted from a config the user maintains by hand.

# ── Page ─────────────────────────────────────────────────────────────────
set default-bg                  "{{colors.surface.default.hex}}"
set default-fg                  "{{colors.on_surface.default.hex}}"

set render-loading              "true"
set render-loading-bg           "{{colors.surface.default.hex}}"
set render-loading-fg           "{{colors.on_surface.default.hex}}"

# ── Status / input bars ──────────────────────────────────────────────────
set statusbar-bg                "{{colors.surface_container.default.hex}}"
set statusbar-fg                "{{colors.on_surface.default.hex}}"

set inputbar-bg                 "{{colors.surface_container_high.default.hex}}"
set inputbar-fg                 "{{colors.on_surface.default.hex}}"

# ── Notifications ────────────────────────────────────────────────────────
set notification-bg             "{{colors.surface_container.default.hex}}"
set notification-fg             "{{colors.on_surface.default.hex}}"
set notification-error-bg       "{{colors.error_container.default.hex}}"
set notification-error-fg       "{{colors.on_error_container.default.hex}}"
set notification-warning-bg     "{{colors.tertiary_container.default.hex}}"
set notification-warning-fg     "{{colors.on_tertiary_container.default.hex}}"

# ── Completion ───────────────────────────────────────────────────────────
set completion-bg               "{{colors.surface_container.default.hex}}"
set completion-fg               "{{colors.on_surface_variant.default.hex}}"
set completion-group-bg         "{{colors.surface_container_low.default.hex}}"
set completion-group-fg         "{{colors.primary.default.hex}}"
set completion-highlight-bg     "{{colors.primary.default.hex}}"
set completion-highlight-fg     "{{colors.on_primary.default.hex}}"

# ── Index (table of contents) ────────────────────────────────────────────
set index-bg                    "{{colors.surface.default.hex}}"
set index-fg                    "{{colors.on_surface.default.hex}}"
set index-active-bg             "{{colors.primary_container.default.hex}}"
set index-active-fg             "{{colors.on_primary_container.default.hex}}"

# ── Search highlights ────────────────────────────────────────────────────
# tertiary for matches, primary for the one you are on, so the active hit
# stands out against the others rather than being the same wash of colour.
set highlight-color             "{{colors.tertiary.default.hex}}"
set highlight-active-color      "{{colors.primary.default.hex}}"

# ── Recolour (dark mode for documents) ───────────────────────────────────
# These only take effect while `set recolor true`. That is DELIBERATELY not set
# here: recolouring rewrites how every document renders, which is a reading
# preference rather than a theme, and forcing it on would change the appearance
# of every PDF without being asked. Toggle it in zathura with the `r` key, or
# add `set recolor "true"` to zathurarc to make it the default.
set recolor-lightcolor          "{{colors.surface.default.hex}}"
set recolor-darkcolor           "{{colors.on_surface.default.hex}}"
# Keep images their real colours when recolouring is on — inverting photographs
# and figures makes them unreadable, which is the usual complaint about recolor.
set recolor-keephue             "true"
