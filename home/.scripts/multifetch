    edit)
        mkdir -p "$(dirname "$SITES_FILE")"
        [[ -f "$SITES_FILE" ]] || printf '# Extra domains, one per line (without https://)\n' > "$SITES_FILE"
        exec "${EDITOR:-nvim}" "$SITES_FILE" ;;
    sites)
        [[ $HEADER == 1 && $FORMAT == table && $QUIET == 0 ]] && printf 'STATE\tCATEGORY\tDOMAIN\n'
        # every domain at once (64 in flight), each given 3 s: a dead one no longer holds up the rest
        printf '%s\n' "${SITES[@]}" | while IFS='|' read -r cat d; do want_cat "$cat" && printf '%s\t%s\n' "$cat" "$d"; done \
            | xargs -P 64 -d '\n' -I{} bash -c 'IFS=$'"'"'\t'"'"' read -r c d <<< "$1"; if timeout 3 getent ahosts "$d" >/dev/null 2>&1; then s=ok; else s=dead; fi; printf "%s\t%s\t%s\n" "$s" "$c" "$d"' _ {} \
            | sort -t$'\t' -k2,2 -k3,3 | while IFS=$'\t' read -r st cat d; do
                (( QUIET )) && continue
                case "$FORMAT" in
                    urls) echo "$d" ;;
                    count) : ;;
                    json) jq -cn --arg s "$st" --arg c "$cat" --arg d "$d" '{state:$s, category:$c, domain:$d}' ;;
                    *) printf '%s\t%s\t%s\n' "$st" "$cat" "$d" ;;
                esac
            done
        exit 0 ;;
esac

# keywords: arguments, -f files, or stdin when it is a pipe and nothing else was given
