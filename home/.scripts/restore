#!/usr/bin/env bash
# restore — restore a snapshot produced by ~/.scripts/backup.
#
# (Named `restore` because `~/.scripts/install/` already exists as a dir of
#  your fresh-install bootstrap scripts.)
#
# Designed to be safe on a *running* machine and useful on a *fresh* one.
# Every destructive op is preceded by a side-snapshot of the current state
# (in /tmp/restore-undo-<ts>/) so you can roll back if something looks wrong.
#
# Usage
#   restore                         — interactive menu
#   restore --from <ts> <section>   — restore section from snapshot <ts>
#   restore --from latest all       — restore everything
#   restore --src <path> …          — read snapshots from <path> instead of
#                                     /mnt/storage/system-backups
#                                     (also honours $BACKUP_ROOT env var)
#   restore bootstrap               — fresh machine: packages → etc → configs
#   restore list                    — list snapshots (delegates to `backup list`)
#
# Sections
#   packages      — paru -S explicit + AUR pkg list + flatpak + cargo
#   etc           — /etc files (sudo)
#   configs       — ~/.config curated dirs
#   dotfiles      — $HOME dotfiles (.zshrc, .gitconfig, …)
#   scripts       — ~/.scripts
#   audio         — ~/.vst, ~/.vst3, ~/.clap, ~/.lv2, ~/.BitwigStudio, ~/.wine, etc.
#   apps          — ~/Applications + ~/.local/share (Telegram, nvim, claude, …)
#   services      — re-enable systemd units listed in the snapshot
#   all           — every section above, asked one by one
#
# Flags
#   --yes         — don't prompt, just do it (dangerous; pairs with --from)
#   --dry-run     — show what would change, write nothing

set -uo pipefail
DEFAULT_DEST_ROOT="/mnt/storage/system-backups"
DEST_ROOT="${BACKUP_ROOT:-$DEFAULT_DEST_ROOT}"
# Persist undo on /mnt/storage so a reboot can't wipe it. Fall back to /tmp
# only if storage isn't mounted (handles "restore on a freshly-installed
# system that hasn't mounted the drive yet" case).
UNDO_TS="$(date +%Y%m%d-%H%M%S)"
if mountpoint -q "$(dirname "$DEST_ROOT")" 2>/dev/null; then
    UNDO_ROOT="$(dirname "$DEST_ROOT")/restore-undo/$UNDO_TS"
else
    UNDO_ROOT="/tmp/restore-undo-$UNDO_TS"
fi

YES=0
DRY=0
FROM=""
SECTION=""

while (($#)); do
    case "$1" in
        --from)    FROM="$2"; shift ;;
        --src)     DEST_ROOT="$2"; shift ;;
        --yes|-y)  YES=1 ;;
        --dry-run) DRY=1 ;;
        list)      exec "$HOME/.scripts/backup" list ;;
        bootstrap) SECTION="bootstrap" ;;
        packages|etc|configs|dotfiles|scripts|audio|apps|services|all)
                   SECTION="$1" ;;
        -h|--help) sed -n '2,30p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *)         echo "unknown arg: $1"; exit 1 ;;
    esac
    shift
done

# ── helpers ───────────────────────────────────────────────────────────────
log()  { printf '\e[1;36m▶ %s\e[0m\n' "$*"; }
ok()   { printf '\e[1;32m✓ %s\e[0m\n' "$*"; }
warn() { printf '\e[1;33m! %s\e[0m\n' "$*"; }
err()  { printf '\e[1;31m✗ %s\e[0m\n' "$*" >&2; }

confirm() {
    (( YES )) && return 0
    read -r -p "  $1 [y/N] " a
    [[ "$a" =~ ^[Yy]$ ]]
}

resolve_snapshot() {
    local t="$1"
    [[ -z "$t" ]] && t="latest"
    [[ -d "$DEST_ROOT/$t" ]] && { echo "$DEST_ROOT/$t"; return 0; }
    local m
    m=$(ls -1 "$DEST_ROOT" 2>/dev/null | grep -E '^[0-9]{8}-[0-9]{6}$' | grep "$t" | tail -1)
    [[ -n "$m" ]] && { echo "$DEST_ROOT/$m"; return 0; }
    err "snapshot not found: $t"; return 1
}

backup_undo() {
    local label="$1"; shift
    local dst="$UNDO_ROOT/$label"
    mkdir -p "$dst"
    for src in "$@"; do
        [[ -e "$src" ]] || continue
        local rel="${src#/}"
        mkdir -p "$dst/$(dirname "$rel")"
        cp -a "$src" "$dst/$rel" 2>/dev/null || sudo cp -a "$src" "$dst/$rel"
    done
}

rsync_run() {
    local src="$1" dst="$2"; shift 2
    if (( DRY )); then
        rsync -aHAX --dry-run --itemize-changes "$@" "$src" "$dst" | head -30
    else
        rsync -aHAX "$@" "$src" "$dst"
    fi
}

# ── interactive menu ──────────────────────────────────────────────────────
pick_snapshot_interactive() {
    [[ -d "$DEST_ROOT" ]] || { err "no snapshots yet — run \`backup\` first"; exit 1; }
    "$HOME/.scripts/backup" list
    echo
    read -r -p "snapshot timestamp (or 'latest'): " FROM
}

if [[ -z "$SECTION" && -z "$FROM" ]]; then
    pick_snapshot_interactive
    cat <<'EOF'

what do you want to restore?
   1) all          everything (interactive per section)
   2) packages     pacman + AUR + flatpak
   3) configs      ~/.config dirs
   4) dotfiles     $HOME dotfiles
   5) scripts      ~/.scripts
   6) etc          /etc files (sudo)
   7) audio        ~/.vst*, ~/.clap, ~/.BitwigStudio, ~/Bitwig Studio, ~/.wine
   8) apps         ~/Applications + ~/.local/share
   9) services     re-enable systemd units
  10) bootstrap    fresh machine: packages → etc → configs → dotfiles → scripts → audio → apps → services
EOF
    read -r -p "choice [1-10]: " choice
    case "$choice" in
        1) SECTION=all       ;; 2) SECTION=packages ;; 3) SECTION=configs ;;
        4) SECTION=dotfiles  ;; 5) SECTION=scripts  ;; 6) SECTION=etc     ;;
        7) SECTION=audio     ;; 8) SECTION=apps     ;; 9) SECTION=services ;;
        10) SECTION=bootstrap ;;
        *) err "invalid choice"; exit 1 ;;
    esac
fi

SNAP=$(resolve_snapshot "$FROM") || exit 1
log "snapshot: $SNAP"
[[ -f "$SNAP/manifest.txt" ]] && sed 's/^/  /' "$SNAP/manifest.txt"
echo

# ── section implementations ───────────────────────────────────────────────
restore_packages() {
    local p="$SNAP/packages"
    [[ -d "$p" ]] || { warn "no packages section in snapshot"; return; }
    log "packages — install pacman explicit + AUR/foreign"
    command -v paru >/dev/null || { err "paru not installed; install it first"; return 1; }

    local explicit_list="$p/pacman-explicit.txt"
    if [[ -f "$explicit_list" ]]; then
        local count; count=$(wc -l <"$explicit_list")
        confirm "install $count explicit packages via paru -S --needed?" || return
        if (( DRY )); then
            echo "  would: paru -S --needed --noconfirm < $explicit_list"
            head -10 "$explicit_list"; echo "  …"
        else
            xargs -a "$explicit_list" paru -S --needed --noconfirm
        fi
    fi

    if [[ -f "$p/flatpak.txt" ]] && command -v flatpak >/dev/null; then
        confirm "install $(wc -l <"$p/flatpak.txt") flatpaks?" && \
            xargs -a "$p/flatpak.txt" -L1 flatpak install -y flathub
    fi
    if [[ -f "$p/cargo.txt" ]] && command -v cargo >/dev/null; then
        confirm "cargo install $(wc -l <"$p/cargo.txt") crates?" && \
            xargs -a "$p/cargo.txt" -L1 cargo install
    fi
    ok "packages restored"
}

restore_etc() {
    [[ -d "$SNAP/etc" ]] || { warn "no etc section"; return; }
    log "etc — restoring /etc files (sudo required)"
    echo "  preview (first 30 changes):"
    sudo rsync -aHAX --dry-run --itemize-changes "$SNAP/etc/" /etc/ | head -30
    confirm "apply changes? (current /etc files will be undo-snapshotted to $UNDO_ROOT/etc)" || return
    (( ! DRY )) && {
        mkdir -p "$UNDO_ROOT/etc"
        (cd "$SNAP/etc" && find . -type f) | while read -r rel; do
            rel="${rel#./}"
            [[ -e "/etc/$rel" ]] || continue
            mkdir -p "$UNDO_ROOT/etc/$(dirname "$rel")"
            sudo cp -a "/etc/$rel" "$UNDO_ROOT/etc/$rel" 2>/dev/null || true
        done
    }
    if (( DRY )); then
        sudo rsync -aHAX --dry-run --itemize-changes "$SNAP/etc/" /etc/
    else
        sudo rsync -aHAX "$SNAP/etc/" /etc/
    fi
    ok "etc restored — undo dir: $UNDO_ROOT/etc"
}

restore_configs() {
    [[ -d "$SNAP/config" ]] || { warn "no config section"; return; }
    log "configs — restoring ~/.config dirs"
    mkdir -p "$HOME/.config"
    for entry in "$SNAP/config"/*; do
        [[ -e "$entry" ]] || continue
        local name; name=$(basename "$entry")
        local dst="$HOME/.config/$name"
        if [[ -e "$dst" ]]; then
            confirm "overwrite ~/.config/$name?" || { warn "skipped $name"; continue; }
            backup_undo "config" "$dst"
        fi
        rsync_run "$entry" "$HOME/.config/" --delete
    done
    ok "configs restored — undo dir: $UNDO_ROOT/config"
}

restore_dotfiles() {
    [[ -d "$SNAP/home" ]] || { warn "no home section"; return; }
    log "dotfiles — restoring \$HOME files"
    while IFS= read -r -d '' f; do
        local rel="${f#$SNAP/home/}"
        local dst="$HOME/$rel"
        if [[ -e "$dst" ]]; then
            confirm "overwrite ~/$rel?" || continue
            backup_undo "home" "$dst"
        fi
        mkdir -p "$(dirname "$dst")"
        rsync_run "$f" "$dst"
    done < <(find "$SNAP/home" -type f -print0)
    ok "dotfiles restored — undo dir: $UNDO_ROOT/home"
}

restore_scripts() {
    [[ -d "$SNAP/scripts" ]] || { warn "no scripts section"; return; }
    log "scripts — restoring ~/.scripts"
    [[ -d "$HOME/.scripts" ]] && {
        confirm "merge into existing ~/.scripts (no delete)?" || return
        backup_undo "scripts" "$HOME/.scripts"
    }
    mkdir -p "$HOME/.scripts"
    rsync_run "$SNAP/scripts/" "$HOME/.scripts/"
    ok "scripts restored — undo dir: $UNDO_ROOT/scripts"
}

restore_audio() {
    [[ -d "$SNAP/audio" ]] || { warn "no audio section"; return; }
    log "audio — restoring ~/.vst*, ~/.clap, Bitwig Studio user data"
    for entry in "$SNAP/audio"/*; do
        [[ -e "$entry" ]] || continue
        local name; name=$(basename "$entry")
        local dst="$HOME/$name"
        if [[ -e "$dst" ]]; then
            confirm "overwrite ~/$name? (will rsync --delete to match snapshot)" \
                || { warn "skipped $name"; continue; }
            backup_undo "audio" "$dst"
        fi
        rsync_run "$entry" "$HOME/" --delete
    done
    ok "audio restored — undo dir: $UNDO_ROOT/audio"
}

restore_apps() {
    [[ -d "$SNAP/apps" ]] || { warn "no apps section"; return; }
    log "apps — restoring ~/Applications + ~/.local/share entries"
    for top in "$SNAP/apps"/*; do
        [[ -e "$top" ]] || continue
        local name; name=$(basename "$top")
        # Two top-level entries: Applications and .local
        local dst="$HOME/$name"
        if [[ -e "$dst" ]]; then
            confirm "merge $top → ~/$name? (rsync, no --delete — your local extras are kept)" \
                || { warn "skipped $name"; continue; }
            backup_undo "apps" "$dst"
        fi
        mkdir -p "$dst"
        rsync_run "$top/" "$dst/"
    done
    ok "apps restored — undo dir: $UNDO_ROOT/apps"
}

restore_services() {
    local p="$SNAP/packages"
    [[ -f "$p/systemd-enabled.txt" ]] || { warn "no systemd lists"; return; }
    log "services — re-enabling systemd units"
    while read -r unit; do
        [[ -z "$unit" ]] && continue
        if (( DRY )); then
            echo "  would: sudo systemctl enable $unit"
        else
            sudo systemctl enable "$unit" 2>/dev/null \
                && ok "enabled $unit" \
                || warn "skipped: $unit (not installed?)"
        fi
    done < "$p/systemd-enabled.txt"
    [[ -f "$p/systemd-user-enabled.txt" ]] && while read -r unit; do
        [[ -z "$unit" ]] && continue
        if (( DRY )); then
            echo "  would: systemctl --user enable $unit"
        else
            systemctl --user enable "$unit" 2>/dev/null \
                && ok "user-enabled $unit" \
                || warn "skipped: $unit"
        fi
    done < "$p/systemd-user-enabled.txt"
}

# ── dispatch ──────────────────────────────────────────────────────────────
case "$SECTION" in
    packages)  restore_packages ;;
    etc)       restore_etc ;;
    configs)   restore_configs ;;
    dotfiles)  restore_dotfiles ;;
    scripts)   restore_scripts ;;
    audio)     restore_audio ;;
    apps)      restore_apps ;;
    services)  restore_services ;;
    all)
        restore_packages
        restore_etc
        restore_configs
        restore_dotfiles
        restore_scripts
        restore_audio
        restore_apps
        restore_services
        ;;
    bootstrap)
        warn "fresh-machine bootstrap — runs all sections non-interactively after one confirm"
        echo "  packages → etc → configs → dotfiles → scripts → services"
        confirm "proceed?" || exit 0
        YES=1
        restore_packages
        restore_etc
        restore_configs
        restore_dotfiles
        restore_scripts
        restore_audio
        restore_apps
        restore_services
        ok "bootstrap complete — reboot recommended"
        ;;
    *) err "no section selected"; exit 1 ;;
esac

[[ -d "$UNDO_ROOT" ]] && ok "undo snapshots saved at $UNDO_ROOT"
