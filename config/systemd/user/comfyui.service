[Unit]
Description=ComfyUI (local image generation backend for GIMP)
# Everything it needs lives on the nuke, which is a USB4 enclosure that does not
# always come up before the session does. Without this the service starts,
# finds no venv, and dies before the disk appears.
RequiresMountsFor=/mnt/nuke9100
After=graphical-session.target

[Service]
Type=simple
ExecStart=/mnt/nuke9100/ai/comfyui
Restart=on-failure
RestartSec=10
# Never let image generation make the desktop stutter: the user is usually
# doing something else while this works, and a 32-thread box at full tilt is
# very noticeable.
Nice=10
IOSchedulingClass=idle
# No core dumps. Debugging this filled the system disk once already.
LimitCORE=0

[Install]
WantedBy=default.target
