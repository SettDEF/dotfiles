          api.alsa.path        = "hw:DJ808"
          api.alsa.period-size = 256
          audio.rate           = 48000
          audio.channels       = 12
          audio.position       = "FL,FR,FC,LFE,RL,RR,FLC,FRC,RC,SL,SR,TC"
          node.passive         = true
      }
  }
]
