[Unit]
Description=KinetiX Motion Physics Daemon (%i)
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
# %i is the input event node, e.g. kinetix@event11.service -> /dev/input/event11.
# A template rather than one fixed unit so a device can be grabbed explicitly
# instead of relying on the daemon's auto-pick.
ExecStart=%h/.scripts/apps/knurl/kinetix --daemon --device /dev/input/%i
Restart=always
RestartSec=3
Environment=PATH=/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
