-- ANSI Color Utilities
local function hex_to_rgb(hex)
    hex = hex:gsub("#", "")
    if #hex == 3 then
        hex = hex:gsub("(.)", "%1%1")
    end
    return tonumber(hex:sub(1, 2), 16),
        tonumber(hex:sub(3, 4), 16),
        tonumber(hex:sub(5, 6), 16)
end

local function set_color(hex, invert)
    local r, g, b = hex_to_rgb(hex)
    if invert then
        r, g, b = 255 - r, 255 - g, 255 - b
    end
    return string.format("\27[38;2;%d;%d;%dm", r, g, b)
end

local function reset_color()
    return "\27[0m"
end

-- Initialize random seed
math.randomseed(config.seed)

-- Math utilities
local function remap(value, low1, high1, low2, high2)
    return low2 + (value - low1) * (high2 - low2) / (high1 - low1)
end

local function noise(x, y)
    return math.sin(x * 12.9898 + y * 78.233) * 43758.5453123 % 1
end

-- Pattern Generators
local patterns = {
    digital_rain = function(w, h)
        local trails = {}
        return function(x, y, frame)
            if frame % 5 == 0 then
                if math.random() < config.styles.matrix.spawn_chance then
                    trails[x] = { pos = 0, speed = math.random(1, 3) }
                end
                for k, v in pairs(trails) do
                    v.pos = v.pos + v.speed
                    if v.pos > h + config.styles.matrix.trail_length then
                        trails[k] = nil
                    end
                end
            end
            return trails[x] and y >= trails[x].pos and y <= trails[x].pos + config.styles.matrix.trail_length
        end
    end,

    circuit = function(w, h)
        return function(x, y)
            return (x % 8 < 2) or (y % 8 < 2) or
                (math.random() < 0.02 and math.abs(x - w / 2) < w / 3)
        end
    end,

    flash_pattern = function(w, h)
        local phase = 0
        return function(x, y, frame)
            phase = phase + config.styles.flash.cycle_speed
            return math.sin(x / 2 + phase) > 0.8 and math.cos(y / 3 + phase) > 0.8
        end
    end,

    block_matrix = function(w, h)
        return function(x, y)
            local block_size = 4
            return (math.floor(x / block_size) + (math.floor(y / block_size)) % 2 == 0)
        end
    end,

    dna = function(w, h)
        return function(x, y, frame)
            local center_x = w / 2
            local center_y = h / 2
            local angle = frame * config.styles.dna.twist_speed
            local radius = math.sqrt((x - center_x) ^ 2 + (y - center_y) ^ 2)

            local strand_angle = angle + (y * 0.1 * config.styles.dna.direction)
            local phase = math.sin(strand_angle) * (h / 4)
            return math.abs(x - center_x - phase) < 1 + (config.styles.dna.num_strands * 2)
        end
    end,

    plasma = function(w, h)
        return function(x, y, frame)
            return true
        end
    end,

    waves = function(w, h)
        return function(x, y, frame)
            local wave1 = math.sin(x / 5 + frame / 10) * 0.5 + 0.5
            local wave2 = math.cos(y / 3 + frame / 15) * 0.5 + 0.5
            return (wave1 + wave2) > 0.8
        end
    end,

    static = function(w, h)
        return function(x, y, frame)
            return math.random() > 0.5
        end
    end
}

-- Color Mode Generators
local color_modes = {
    matrix = function(palette)
        return function(x, y, frame)
            local vertical_speed = 0.3
            local horizontal_freq = 0.2
            local wave = math.sin(y * 0.5 + frame * vertical_speed) * 0.5 + 0.5
            local hue_variation = math.sin(x * horizontal_freq) * 0.2
            local index = 1 + math.floor((wave + hue_variation) * (#palette - 1))
            index = math.max(1, math.min(index, #palette))
            return palette[index]
        end
    end,

    flash = function(palette)
        local counter = 0
        return function(x, y, frame)
            counter = counter + 1
            return palette[(counter % #palette) + 1]
        end
    end,

    gradient = function(palette, w, h)
        return function(x, y)
            local ratio = (x / w + y / h) / 2
            return palette[math.floor(ratio * #palette) + 1]
        end
    end,

    blocks = function(palette, w, h)
        return function(x, y)
            local block_x = math.floor(x / 4)
            local block_y = math.floor(y / 4)
            return palette[(block_x + block_y * 7) % #palette + 1]
        end
    end,

    wave = function(palette, w, h)
        return function(x, y, frame)
            local wave1 = math.sin(x / 5 + frame / 10)
            local wave2 = math.cos(y / 3 + frame / 15)
            local index = 1 + (math.floor((wave1 + wave2) * #palette) % #palette)
            return palette[index]
        end
    end,

    swirl = function(palette, w, h)
        return function(x, y, frame)
            local cx, cy = w / 2, h / 2
            local dx, dy = x - cx, y - cy
            local angle = math.atan2(dy, dx) + frame / 20
            local dist = math.sqrt(dx ^ 2 + dy ^ 2) / math.max(w, h)
            local index = 1 + math.floor(
                (math.sin(angle * 5 + dist * 10) + 1) * (#palette - 1) / 2
            )
            return palette[index]
        end
    end,

    static = function(palette, w, h)
        return function(x, y, frame)
            local n = noise(x + frame, y) * #palette
            return palette[1 + math.floor(n % #palette)]
        end
    end,

    psychedelic = function(palette, w, h)
        return function(x, y, frame)
            local hue = (x + y + frame) % #palette
            return palette[1 + hue]
        end
    end,

    scanline = function(palette, w, h)
        return function(x, y, frame)
            local scan = math.sin(y / 2 + frame / 5) > 0.8
            return scan and palette[2] or palette[1]
        end
    end
}

-- Rendering Engine
local function render_frame(config, frame)
    local w, h = config.width, config.height
    local palette = config.palettes[config.palette] or config.palettes.hue
    local pattern = patterns[config.pattern](w, h)
    local color_fn = color_modes[config.color_mode](palette, w, h)
    local glyphs = config.glyphs[config.glyph_set]

    local buffer = {}
    for y = 1, h do
        buffer[y] = {}
        for x = 1, w do
            local active = pattern(x, y, frame)
            local color = color_fn(x, y, frame)
            local char = glyphs[(x + y + frame) % #glyphs + 1]

            if config.invert_mode == "presence" or config.invert_mode == "both" then
                active = not active
            end

            buffer[y][x] = active and
                set_color(color, config.invert_mode == "color" or config.invert_mode == "both") ..
                char ..
                reset_color() or " "
        end
    end

    io.write("\27[2J\27[H")
    for y = 1, h do
        print(table.concat(buffer[y]))
    end
end

-- Animation System
local function animate(config)
    local start = os.clock()
    local frame = 0
    while os.clock() - start < config.animation.duration do
        render_frame(config, frame)
        frame = frame + 1
        os.execute("sleep " .. 1 / config.animation.fps)
    end
end



-- Command Line Interface
local function process_args(args)
    local valid = {
        patterns = { "digital_rain", "circuit", "flash_pattern", "block_matrix", "dna", "plasma", "waves", "static" },
        color_modes = { "matrix", "flash", "gradient", "blocks", "wave", "swirl", "static", "psychedelic", "scanline" },
        palettes = { "base", "accent", "sec", "def", "tone", "hue", "pastel", "extra" },
        glyphs = { "matrix", "blocks", "tech", "symbols", "dna", "lines" },
        invert_modes = { "none", "color", "presence", "both" }
    }

    local function validate_option(value, category, name)
        if not value then error("Missing value for " .. name) end
        for _, v in ipairs(valid[category]) do
            if v == value then return true end
        end
        error(string.format("Invalid %s: %s (valid: %s)",
            name, value, table.concat(valid[category], ", ")))
    end

    local i = 1
    while i <= #args do
        local arg = args[i]
        if arg == "--help" then
            print("Terminal Art Generator\nOptions:")
            print("  --width W              Set terminal width")
            print("  --height H             Set terminal height")
            print("  --pattern [" .. table.concat(valid.patterns, "|") .. "]")
            print("  --color-mode [" .. table.concat(valid.color_modes, "|") .. "]")
            print("  --palette [" .. table.concat(valid.palettes, "|") .. "]")
            print("  --glyphs [" .. table.concat(valid.glyphs, "|") .. "]")
            print("  --invert-mode [" .. table.concat(valid.invert_modes, "|") .. "]")
            print("  --animate FPS DURATION  Enable animation")
            os.exit()
        elseif arg == "--width" then
            config.width = tonumber(args[i + 1]) or config.width
            i = i + 2
        elseif arg == "--height" then
            config.height = tonumber(args[i + 1]) or config.height
            i = i + 2
        elseif arg == "--pattern" then
            config.pattern = args[i + 1]
            validate_option(config.pattern, "patterns", "pattern")
            i = i + 2
        elseif arg == "--color-mode" then
            config.color_mode = args[i + 1]
            validate_option(config.color_mode, "color_modes", "color mode")
            i = i + 2
        elseif arg == "--palette" then
            config.palette = args[i + 1]
            validate_option(config.palette, "palettes", "palette")
            i = i + 2
        elseif arg == "--glyphs" then
            config.glyph_set = args[i + 1]
            validate_option(config.glyph_set, "glyphs", "glyph set")
            i = i + 2
        elseif arg == "--invert-mode" then
            config.invert_mode = args[i + 1]
            validate_option(config.invert_mode, "invert_modes", "invert mode")
            i = i + 2
        elseif arg == "--animate" then
            config.animation.enable = true
            config.animation.fps = tonumber(args[i + 1]) or 30
            config.animation.duration = tonumber(args[i + 2]) or 5
            i = i + 3
        else
            error("Unknown option: " .. arg)
        end
    end

    -- Set randomized defaults if no arguments provided
    math.randomseed(config.seed)
    if not config.pattern then
        config.pattern = valid.patterns[math.random(#valid.patterns)]
    end
    if not config.color_mode then
        config.color_mode = valid.color_modes[math.random(#valid.color_modes)]
    end
    if not config.palette then
        config.palette = valid.palettes[math.random(#valid.palettes)]
    end
    if not config.glyph_set then
        config.glyph_set = valid.glyphs[math.random(#valid.glyphs)]
    end
end

-- Main execution
process_args(arg)
if config.animation.enable then
    animate(config)
else
    render_frame(config, 0)
end
