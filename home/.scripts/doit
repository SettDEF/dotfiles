backup_todos() {
  local folder="$1"
  if [[ -z "$folder" ]]; then
    folder=$(select_project)
    if [[ -z "$folder" ]]; then
      echo -e "${YELLOW}No project selected.${NC}"
      return 1
    fi
  fi
  if [[ ! -d "$folder" ]]; then
    echo -e "${RED}Error: Project directory does not exist: ${folder}${NC}" >&2
    return 1
  fi
  local backup_dir="${folder}/backup_$(date '+%Y%m%d_%H%M%S')"
  mkdir -p "$backup_dir"
  cp -r "$folder"/*${DEFAULT_TODO_EXTENSION} "$backup_dir" 2>/dev/null
  cp -r "$folder/${ARCHIVE_FOLDER}" "$backup_dir" 2>/dev/null
  echo -e "${GREEN}TODOs backed up to:${NC} ${backup_dir}"
}

restore_todos() {
  local folder="$1"
  if [[ -z "$folder" ]]; then
    folder=$(select_project)
    if [[ -z "$folder" ]]; then
      echo -e "${YELLOW}No project selected.${NC}"
      return 1
    fi
  fi
  if [[ ! -d "$folder" ]]; then
    echo -e "${RED}Error: Project directory does not exist: ${folder}${NC}" >&2
    return 1
  fi
  local backups=()
  mapfile -t backups < <(find "$folder" -maxdepth 1 -type d -name "backup_*" -exec basename {} \; | sort -r)
  if [[ ${#backups[@]} -eq 0 ]]; then
    echo -e "${YELLOW}No backups found in ${folder}.${NC}"
    return 1
  fi
  local backup
  if use_fzf; then
    backup=$(printf "%s\n" "${backups[@]}" | fzf --prompt="Select backup to restore: ")
  else
    echo -e "${GREEN}Available backups:${NC}"
    printf "%s\n" "${backups[@]}" | nl -w2 -s'. '
    read -r -p "$(echo -e "${YELLOW}Enter backup number:${NC} ")" input
    if [[ "$input" =~ ^[0-9]+$ ]] && [[ "$input" -le ${#backups[@]} ]]; then
      backup=${backups[$((input-1))]}
    fi
  fi
  if [[ -z "$backup" ]]; then
    echo -e "${YELLOW}No backup selected.${NC}"
    return 1
  fi
  local backup_dir="${folder}/${backup}"
  read -r -p "$(echo -e "${YELLOW}Restore from ${backup}? This will overwrite existing TODOs. (y/n):${NC} ")" confirm
  if [[ "$confirm" =~ ^[Yy]$ ]]; then
    rm -f "$folder"/*${DEFAULT_TODO_EXTENSION}
    rm -rf "$folder/${ARCHIVE_FOLDER}"
    cp -r "$backup_dir"/* "$folder"/
    echo -e "${GREEN}TODOs restored from:${NC} ${backup_dir}"
  else
    echo -e "${YELLOW}Restore cancelled.${NC}"
  fi
}

toggle_checkbox() {
  local folder="$1"
  local todo_name="$2"
  if [[ -z "$folder" ]]; then
    folder=$(select_project)
    if [[ -z "$folder" ]]; then
      echo -e "${YELLOW}No project selected.${NC}"
      return 1
    fi
  fi
  if [[ ! -d "$folder" ]]; then
    echo -e "${RED}Error: Project directory does not exist: ${folder}${NC}" >&2
    return 1
  fi

  local todos=()
  mapfile -t todos < <(find "$folder" -maxdepth 1 -type f -name "*${DEFAULT_TODO_EXTENSION}" -not -path "*/${ARCHIVE_FOLDER}/*" -exec sh -c 'basename {}' \; | sort)
  if [[ ${#todos[@]} -eq 0 ]]; then
    echo -e "${YELLOW}No active TODOs found in ${folder}.${NC}"
    return 1
  fi

  local file
  if [[ -z "$todo_name" ]]; then
    if use_fzf; then
      file=$(printf "%s\n" "${todos[@]}" | fzf --prompt="Select TODO to toggle checkbox: ")
    else
      echo -e "${GREEN}Available TODOs:${NC}"
      printf "%s\n" "${todos[@]}" | nl -w2 -s'. '
      read -r -p "$(echo -e "${YELLOW}Enter TODO number or name:${NC} ")" input
      if [[ "$input" =~ ^[0-9]+$ ]] && [[ "$input" -le ${#todos[@]} ]]; then
        file=${todos[$((input-1))]}
      else
        file=$(printf "%s\n" "${todos[@]}" | grep -Fx "$input" || echo "")
      fi
    fi
  else
    file=$(printf "%s\n" "${todos[@]}" | grep -Fx "$todo_name${DEFAULT_TODO_EXTENSION}" || echo "")
  fi

  if [[ -z "$file" ]]; then
    echo -e "${RED}TODO not found.${NC}" >&2
    return 1
  fi

  local todo_file="${folder}/${file}"
  sed -i 's/\[ \]/[x]/g; s/\[x\]/[ ]/g' "$todo_file"
  echo -e "${GREEN}Toggled checkboxes in TODO:${NC} ${file}"
}

# --- Timer Management Functions ---

start_timer() {
  local task_name="$1"
  if [[ -z "$task_name" ]]; then
    read -r -p "$(echo -e "${YELLOW}Enter task name or select TODO (leave empty to select):${NC} ")" task_name
  fi
  if [[ -z "$task_name" ]]; then
    local folder
    folder=$(select_project)
    if [[ -z "$folder" ]]; then
      echo -e "${YELLOW}No project selected.${NC}"
      return 1
    fi
    local todos=()
    mapfile -t todos < <(find "$folder" -maxdepth 1 -type f -name "*${DEFAULT_TODO_EXTENSION}" -not -path "*/${ARCHIVE_FOLDER}/*" -exec sh -c 'basename {}' \; | sort)
    if [[ ${#todos[@]} -eq 0 ]]; then
      echo -e "${YELLOW}No active TODOs found in ${folder}.${NC}"
      return 1
    fi
    if use_fzf; then
      task_name=$(printf "%s\n" "${todos[@]}" | fzf --prompt="Select TODO to start timer: ")
    else
      echo -e "${GREEN}Available TODOs:${NC}"
      printf "%s\n" "${todos[@]}" | nl -w2 -s'. '
      read -r -p "$(echo -e "${YELLOW}Enter TODO number or name:${NC} ")" input
      if [[ "$input" =~ ^[0-9]+$ ]] && [[ "$input" -le ${#todos[@]} ]]; then
        task_name=${todos[$((input-1))]}
      else
        task_name=$(printf "%s\n" "${todos[@]}" | grep -Fx "$input" || echo "")
      fi
    fi
  fi
  if [[ -z "$task_name" ]]; then
    echo -e "${RED}Task name cannot be empty.${NC}" >&2
    return 1
  fi
  local sanitized_task
  sanitized_task=$(sanitize_filename "$task_name")
  local timer_file="${TIMER_DIR}/${sanitized_task}.timer"
  if [[ -f "$timer_file" ]]; then
    echo -e "${YELLOW}Timer already running for task: ${task_name}${NC}"
    return 0
  fi
  echo "$(date +%s)" > "$timer_file"
  echo -e "${GREEN}Timer started for task:${NC} ${task_name}"
}

stop_timer() {
  local task_name="$1"
  if [[ -z "$task_name" ]]; then
    local timers=()
    mapfile -t timers < <(find "$TIMER_DIR" -type f -name "*.timer" -exec sh -c 'basename {} .timer' \; | sort)
    if [[ ${#timers[@]} -eq 0 ]]; then
      echo -e "${YELLOW}No running timers found.${NC}"
      return 1
    fi
    if use_fzf; then
      task_name=$(printf "%s\n" "${timers[@]}" | fzf --prompt="Select timer to stop: ")
    else
      echo -e "${GREEN}Running timers:${NC}"
      printf "%s\n" "${timers[@]}" | nl -w2 -s'. '
      read -r -p "$(echo -e "${YELLOW}Enter timer number or name:${NC} ")" input
      if [[ "$input" =~ ^[0-9]+$ ]] && [[ "$input" -le ${#timers[@]} ]]; then
        task_name=${timers[$((input-1))]}
      else
        task_name=$(printf "%s\n" "${timers[@]}" | grep -Fx "$input" || echo "")
      fi
    fi
  fi
  if [[ -z "$task_name" ]]; then
    echo -e "${RED}Task name cannot be empty.${NC}" >&2
    return 1
  fi
  local sanitized_task
  sanitized_task=$(sanitize_filename "$task_name")
  local timer_file="${TIMER_DIR}/${sanitized_task}.timer"
  if [[ ! -f "$timer_file" ]]; then
    echo -e "${YELLOW}No timer found for task: ${task_name}${NC}"
    return 1
  fi
  local start_time
  start_time=$(cat "$timer_file")
  local end_time
  end_time=$(date +%s)
  local duration=$((end_time - start_time))
  local hours=$((duration / 3600))
  local minutes=$(( (duration % 3600) / 60 ))
  local seconds=$((duration % 60))
  rm -f "$timer_file"
  echo -e "${GREEN}Timer stopped for task: ${task_name}${NC}"
  printf "Duration: %02d:%02d:%02d\n" $hours $minutes $seconds
}

list_timers() {
  local timers=()
  mapfile -t timers < <(find "$TIMER_DIR" -type f -name "*.timer" -exec sh -c 'basename {} .timer' \; | sort)
  if [[ ${#timers[@]} -eq 0 ]]; then
    echo -e "${YELLOW}No running timers found.${NC}"
    return 0
  fi
  echo -e "${GREEN}Running Timers:${NC}"
  for timer in "${timers[@]}"; do
    local start_time
    start_time=$(cat "${TIMER_DIR}/${timer}.timer")
    local current_time
    current_time=$(date +%s)
    local duration=$((current_time - start_time))
    local hours=$((duration / 3600))
    local minutes=$(( (duration % 3600) / 60 ))
    local seconds=$((duration % 60))
    printf "%s (Running for %02d:%02d:%02d)\n" "$timer" $hours $minutes $seconds
  done
}

scan_project_files() {
  local folder="$1"
  if [[ -z "$folder" ]]; then
    folder=$(select_project)
    if [[ -z "$folder" ]]; then
      echo -e "${YELLOW}No project selected.${NC}"
      return 1
    fi
  fi
  if [[ ! -d "$folder" ]]; then
    echo -e "${RED}Error: Project directory does not exist: ${folder}${NC}" >&2
    return 1
  fi
  echo -e "${GREEN}Scanning project files for TODO keywords in ${folder}:${NC}"
  local results=()
  for keyword in "${TODO_KEYWORDS[@]}"; do
    mapfile -t keyword_results < <(grep -rni --exclude-dir="${ARCHIVE_FOLDER}" --exclude="*${DEFAULT_TODO_EXTENSION}" "$keyword" "$folder" 2>/dev/null)
    for result in "${keyword_results[@]}"; do
      results+=("$keyword|$result")
    done
  done
  if [[ ${#results[@]} -eq 0 ]]; then
    echo -e "${YELLOW}No TODO keywords found in project files.${NC}"
    return 0
  fi
  echo -e "${GREEN}Found TODOs:${NC}"
  for result in "${results[@]}"; do
    local keyword=$(echo "$result" | cut -d'|' -f1)
    local details=$(echo "$result" | cut -d'|' -f2-)
    local file=$(echo "$details" | cut -d':' -f1)
    local line=$(echo "$details" | cut -d':' -f2)
    local content=$(echo "$details" | cut -d':' -f3-)
    printf "%s:%d: %s: %s\n" "$file" "$line" "$keyword" "$content"
  done
}

# --- Main Command Handlers ---

handle_project_commands() {
  local subcommand="$1"
  shift
  case "$subcommand" in
    add)
      add_project "$@"
      ;;
    list)
      list_projects
      ;;
    select)
      local project
      project=$(select_project)
      if [[ -n "$project" ]]; then
        set_last_project "$project"
        echo -e "${GREEN}Selected project:${NC} ${project}"
      fi
      ;;
    remove)
      remove_project "$@"
      ;;
    *)
      echo -e "${RED}Unknown project subcommand: ${subcommand}${NC}"
      echo -e "Usage: $0 project {add|list|select|remove} [args]"
      exit 1
      ;;
  esac
}

