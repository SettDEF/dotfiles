    "*/CrashLog/*"
    "*/nohup.out"
    "*/tmp/*"
    "$HOME/.BitwigStudio"
    "$HOME/Bottles"
    "$HOME/.cache"
    "$HOME/.cargo"
    "$HOME/.codeium"
    "$HOME/.conda"
    "$HOME/.dmrc"
    "$HOME/.ds_cache"
    "$HOME/.flatpak-builder"
    "$HOME/.history"
    "$HOME/.java"
    "$HOME/.local"
    "$HOME/.mono"
    "$HOME/.mozilla"
    "$HOME/.npm"
    "$HOME/.rustup"
    "$HOME/.secret"
    "$HOME/.texlive"
    "$HOME/.torrent"
    "$HOME/.var"
    "$HOME/.viminfo"
    "$HOME/.wget-hsts"
