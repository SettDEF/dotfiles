-- Seed generation from command arguments
local function generate_seed(args)
    local seed_str = table.concat(args, " ")
    local seed = 0
    for i = 1, #seed_str do
        seed = seed + string.byte(seed_str, i) * i
    end
    return seed + os.time()
end

-- Fisher-Yates shuffle
local function shuffle(tbl, seed)
    math.randomseed(seed)
    for i = #tbl, 2, -1 do
        local j = math.random(i)
        tbl[i], tbl[j] = tbl[j], tbl[i]
    end
    return tbl
end

local function get_terminal_size()
    local handle = io.popen("stty size 2>/dev/null")
    if not handle then
        return 80, 24 -- Fallback to default size if command fails
    end
    local result = handle:read("*a")
    handle:close()
    local rows, cols = result:match("(%d+)%s+(%d+)")
    return tonumber(cols) or 80, tonumber(rows) or 24
end

