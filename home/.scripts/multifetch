else
    KEYWORDS=("${WORDS[@]}")   # quoted arguments: one keyword each
fi
KEYWORDS+=("${KEYWORDS_IN[@]}")
if [[ ${#KEYWORDS[@]} -eq 0 ]]; then
    [[ -t 0 ]] || die "no keyword (give one, or pipe them in)"
    read -r -p "Keyword: " kw
    [[ -n "$kw" ]] || exit 2
    KEYWORDS=("$kw")
fi
# no mode chosen: fzf on a terminal, a table in a pipe (like ls)
[[ -z "$MODE" ]] && { if [[ -t 1 && $OPEN == 0 ]]; then MODE=pick; else MODE=print; fi; }

# emit: rows "category<TAB>label<TAB>url" on stdin, printed as --urls, --json or a
# table; false when there was none (the exit status of every listing mode)
emit() {
    local n=0 cat label url
    [[ $FORMAT == table && $HEADER == 1 && $QUIET == 0 ]] && printf 'CATEGORY\tLABEL\tURL\n'
    [[ $FORMAT == count ]] && HEADER=0
    while IFS=$'\t' read -r cat label url; do
        (( MAX > 0 && n >= MAX )) && break
        n=$((n + 1))
        (( QUIET )) || [[ $FORMAT == count ]] && continue
        case "$FORMAT" in
            urls) printf '%s\n' "$url" ;;
            json) jq -cn --arg c "$cat" --arg l "$label" --arg u "$url" '{category:$c, label:$l, url:$u}' ;;
            *) if (( C )); then printf '\033[33m%s\033[0m\t%s\t\033[2m%s\033[0m\n' "$cat" "$label" "$url"; else printf '%s\t%s\t%s\n' "$cat" "$label" "$url"; fi ;;
        esac
    done
    [[ $FORMAT == count && $QUIET == 0 ]] && echo "$n"
    (( n > 0 ))
}

# Every search as: category \t label \t query-or-empty \t browser-url
build_searches() {
    local kw q p e cat dom site name tmpl enc
    for kw in "${KEYWORDS[@]}"; do
        q="\"$kw\""
        for p in "${PATTERNS[@]}"; do
            printf 'web\t%s %s\t%s\thttps://www.google.com/search?q=%s\n' "$q" "$p" "$q $p" "$(urlencode "$q $p")"
        done
        for e in "${SITES[@]}"; do
            cat="${e%%|*}"; dom="${e#*|}"
            printf '%s\t%s site:%s\t%s\thttps://www.google.com/search?q=%s\n' "$cat" "$q" "$dom" "$q site:$dom" "$(urlencode "$q site:$dom")"
        done
        enc="$(urlencode "$kw")"
        for e in "${DIRECT[@]}"; do
            cat="${e%%|*}"; site="${e#*|}"; name="${site%%|*}"; tmpl="${site#*|}"
            printf '%s\t%s: %s\t\t%s\n' "$cat" "$name" "$kw" "${tmpl//\{\}/$enc}"
        done
        for p in download "free download"; do
            printf 'web\tBing %s %s\t\thttps://www.bing.com/search?q=%s\n' "$q" "$p" "$(urlencode "$q $p")"
            printf 'web\tYandex %s %s\t\thttps://yandex.com/search/?text=%s\n' "$q" "$p" "$(urlencode "$q $p")"
        done
    done
}

