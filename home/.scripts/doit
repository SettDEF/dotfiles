        file=${todos[$((input-1))]}
      else
        file=$(printf "%s\n" "${todos[@]}" | grep -Fx "$input" || echo "")
      fi
    fi
  else
    if [[ "$todo_name" =~ ^[0-9]+$ ]] && [[ "$todo_name" -le ${#todos[@]} ]]; then
      file=${todos[$((todo_name-1))]}
    else
      file=$(printf "%s\n" "${todos[@]}" | grep -Fx "$todo_name${DEFAULT_TODO_EXTENSION}" || echo "")
    fi
