#!/bin/bash

# chshet.sh - Dedicated Cheatsheet Script
# Built-in + custom from ~/.local/share/cheatsheets/*.md
# Usage: chshet [options]

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Paths
CUSTOM_SHEETS_DIR="$HOME/.local/share/cheatsheets"
SCRIPT_DIR="$(dirname "$(realpath "$0")")"
LOG_FILE="$SCRIPT_DIR/history.log"

# Editor fallback
EDITOR="${EDITOR:-vim}"

log_action() {
    local action="$1"
    local details="$2"
    echo "$(date '+%Y-%m-%d %H:%M:%S') - Action: $action | Details: $details" >> "$LOG_FILE"
    echo -e "${GREEN}Logged: $action${NC}"
}

show_help() {
    echo -e "${GREEN}chshet.sh - Cheatsheet Manager${NC}"
    echo "Handles built-in and custom cheatsheets (.md files)."
    echo ""
    echo "Usage: $0 [OPTIONS]"
    echo "Options:"
    echo "  -h, --help          Show help"
    echo "  -c CHEATSHEET       View cheatsheet (built-in: pacman,update,general,history | custom:SHEET)"
    echo "  -e CHEATSHEET       Export cheatsheet to stdout"
    echo "  -l                  List built-in cheatsheets"
    echo "  -C                  List custom cheatsheets"
    echo "  -f FILE.md [TEMPLATE] Create new custom cheatsheet (default: md)"
    echo "  -o FILE.md          Open custom cheatsheet in \$EDITOR ($EDITOR)"
    echo ""
    echo "Examples:"
    echo "  $0 -c pacman                    # Built-in"
    echo "  $0 -c custom:arch-git           # Custom"
    echo "  $0 -e custom:arch-git > git.md  # Export"
    echo "  $0 -C                           # List customs"
    echo "  $0 -f neovim.md md              # Create new"
    echo "  $0 -o arch-git.md               # Open/edit"
    exit 0
}

list_builtin() {
    echo -e "${YELLOW}Built-in Cheatsheets:${NC}"
    echo "  pacman     - Package management"
    echo "  update     - System updates"
    echo "  general    - General Arch commands"
    echo "  history    - History & logs"
    echo ""
    log_action "Built-in listed" ""
}

list_custom_cheatsheets() {
    mkdir -p "$CUSTOM_SHEETS_DIR"
    echo -e "${YELLOW}Custom Cheatsheets (in $CUSTOM_SHEETS_DIR):${NC}"
    local count=0
    for file in "$CUSTOM_SHEETS_DIR"/*.md; do
        if [[ -f "$file" ]]; then
            basename "$file" .md
            ((count++))
        fi
    done
    [[ $count -eq 0 ]] && echo "  (None—create with $0 -f sheet.md md)"
    echo ""
    log_action "Custom listed" "$count found"
}

show_custom_cheatsheet() {
    local sheet_name="$1"
    local full_path="$CUSTOM_SHEETS_DIR/${sheet_name}.md"
    mkdir -p "$CUSTOM_SHEETS_DIR"
    if [[ -f "$full_path" ]]; then
        echo -e "${YELLOW}=== Custom: $sheet_name ===${NC}"
        cat "$full_path"
    else
        echo -e "${RED}Custom '$sheet_name.md' not found in $CUSTOM_SHEETS_DIR${NC}"
        echo "Create: $0 -f $sheet_name.md md"
        exit 1
    fi
    log_action "Custom viewed" "$sheet_name"
}

show_builtin_cheatsheet() {
    local category="$1"
    case "$category" in
        "pacman")
            echo -e "${YELLOW}=== Pacman Cheatsheet ===${NC}"
            echo "Install: pacman -S pkg"
            echo "Search: pacman -Ss pkg"
            echo "Remove: pacman -Rns pkg"
            echo "Update: pacman -Syu"
            echo "Info: pacman -Qi pkg"
            ;;
        "update")
            echo -e "${YELLOW}=== Update Cheatsheet ===${NC}"
            echo "Full sync: pacman -Syu"
            echo "Check updates: checkupdates"
            echo "AUR (yay): yay -Syu"
            echo "Mirrorlist: reflector --latest 20 --sort rate --save /etc/pacman.d/mirrorlist"
            echo "Clean cache: pacman -Sc"
            ;;
        "general")
            echo -e "${YELLOW}=== General Arch Cheatsheet ===${NC}"
            echo "Installed pkgs: pacman -Q"
            echo "Processes: ps aux | grep proc"
            echo "Disk usage: df -h"
            echo "Network: ip a"
            echo "Firewall: firewall-cmd --list-all"
            ;;
        "history")
            echo -e "${YELLOW}=== History Cheatsheet ===${NC}"
            echo "Bash history: history | grep keyword"
            echo "Clear bash: history -c && history -w"
            echo "Git log: git log --oneline"
            echo "Pacman log: grep 'installed' /var/log/pacman.log"
            echo "Pacman orphans: pacman -Qdt"
            ;;
        *)
            echo -e "${RED}Unknown built-in: $category${NC}"
            echo "Available: pacman, update, general, history"
            exit 1
            ;;
    esac
    log_action "Built-in viewed" "$category"
}

show_cheatsheet() {
    local category="$1"
    if [[ "$category" == custom:* ]]; then
        show_custom_cheatsheet "${category#custom:}"
    else
        show_builtin_cheatsheet "$category"
    fi
}

create_cheatsheet() {
    local file_name="$1"
    local template="${2:-md}"
    local full_path="$CUSTOM_SHEETS_DIR/$file_name"
    mkdir -p "$CUSTOM_SHEETS_DIR"
    if [[ -f "$full_path" ]]; then
        echo -e "${YELLOW}File '$full_path' exists. Overwrite? (y/N): ${NC}"
        read -r confirm
        [[ "$confirm" != [Yy]* ]] && exit 0
        rm "$full_path"
    fi
    case "$template" in
        "md")
            cat > "$full_path" << EOF
# $file_name

## Commands
Add your cheats here.

Last updated: $(date '+%Y-%m-%d')
EOF
            ;;
        *)
            touch "$full_path"
            echo "# $file_name - $(date '+%Y-%m-%d')" >> "$full_path"
            ;;
    esac
    echo -e "${GREEN}Created: $full_path${NC}"
    log_action "Cheatsheet created" "$file_name ($template)"
}

open_cheatsheet() {
    local file_name="$1"
    local full_path="$CUSTOM_SHEETS_DIR/$file_name"
    mkdir -p "$CUSTOM_SHEETS_DIR"
    if [[ ! -f "$full_path" ]]; then
        echo -e "${YELLOW}Cheatsheet '$full_path' missing. Create? (y/N): ${NC}"
        read -r confirm
        if [[ "$confirm" == [Yy]* ]]; then
            create_cheatsheet "$file_name" "md"
        else
            exit 0
        fi
    fi
    echo -e "${GREEN}Opening $full_path in $EDITOR...${NC}"
    log_action "Cheatsheet opened" "$file_name"
    exec "$EDITOR" "$full_path"
}

show_history() {
    if [[ ! -f "$LOG_FILE" ]]; then
        echo -e "${YELLOW}No history.${NC}"
        return
    fi
    echo -e "${YELLOW}Recent Cheatsheet History:${NC}"
    grep "Cheatsheet\|Custom" "$LOG_FILE" | tail -10
}

# Arg parsing
sheet=""
file_name=""
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_help
            ;;
        -l)
            list_builtin
            exit 0
            ;;
        -C)
            list_custom_cheatsheets
            exit 0
            ;;
        -c)
            shift
            sheet="$1"
            show_cheatsheet "$sheet"
            exit 0
            ;;
        -e)
            shift
            sheet="$1"
            show_cheatsheet "$sheet"
            echo ""  # Newline for export
            exit 0
            ;;
        -f)
            shift
            file_name="$1"
            shift
            template="${1:-md}"
            create_cheatsheet "$file_name" "$template"
            exit 0
            ;;
        -o)
            shift
            file_name="$1"
            open_cheatsheet "$file_name"
            exit 0
            ;;
        *)
            echo -e "${RED}Unknown '$1'. Run '$0 -h'${NC}"
            exit 1
            ;;
    esac
    shift
done

show_help
