#!/usr/bin/env python3
import os
import sys
import time
import json
import select
import argparse
import struct
import threading
import subprocess

STATUS_FILE = "/dev/shm/logitune-cli-status.json"
DEVICE_NAME = "MX Master 3S"

# Global state dictionaries
MOUSE_STATE = {
    "connected": False,
    "dpi": 0,
    "smartshift_enabled": False,
    "smartshift_threshold": 10,
    "hires_scroll": True,
    "battery_percentage": 0,
    "battery_state": "Disconnected"
}

GESTURE_ACTIVE = False
GESTURE_DIR = "None"

def find_device():
    """Verify if the mouse is connected by scanning /sys/class/hidraw."""
    for name in os.listdir('/sys/class/hidraw'):
        uevent_path = f'/sys/class/hidraw/{name}/device/uevent'
        if os.path.exists(uevent_path):
            try:
                with open(uevent_path, 'r') as f:
                    content = f.read()
                    if 'Logitech MX Master' in content or 'B034' in content:
                        return f'/dev/{name}'
            except Exception:
                continue
    return None

def daemon_write_status():
    """Write current state to shm JSON for Quickshell consumption."""
    status = {
        "connected": MOUSE_STATE["connected"],
        "dpi": MOUSE_STATE["dpi"],
        "smartshift_enabled": MOUSE_STATE["smartshift_enabled"],
        "smartshift_threshold": MOUSE_STATE["smartshift_threshold"],
        "hires_scroll": MOUSE_STATE["hires_scroll"],
        "battery_percentage": MOUSE_STATE["battery_percentage"],
        "battery_state": MOUSE_STATE["battery_state"],
        "gesture_active": GESTURE_ACTIVE,
        "gesture_direction": GESTURE_DIR
    }
    try:
        temp_file = STATUS_FILE + ".tmp"
        with open(temp_file, "w") as f:
            json.dump(status, f)
        os.rename(temp_file, STATUS_FILE)
    except Exception as e:
        print(f"Error writing status file: {e}", file=sys.stderr)

def get_current_state_dict():
    """Query Solaar to parse all live settings from the mouse."""
    state = {
        "connected": False,
        "dpi": 0,
        "smartshift_enabled": False,
        "smartshift_threshold": 10,
        "hires_scroll": True,
        "battery_percentage": 0,
        "battery_state": "Disconnected"
    }
    if not find_device():
        return state

    try:
        res = subprocess.check_output(["solaar", "config", DEVICE_NAME], stderr=subprocess.DEVNULL).decode()
        state["connected"] = True
        for line in res.splitlines():
            if '=' in line:
                k, v = line.split('=', 1)
                k = k.strip()
                v = v.strip()
                if k == 'dpi':
                    try:
                        state["dpi"] = int(v)
                    except:
                        pass
                elif k == 'scroll-ratchet':
                    state["smartshift_enabled"] = (v == 'Ratcheted')
                elif k == 'smart-shift':
                    try:
                        state["smartshift_threshold"] = int(v)
                    except:
                        pass
                elif k == 'hires-smooth-resolution':
                    state["hires_scroll"] = (v.lower() in ('true', 'on', '1'))
    except Exception:
        pass

    try:
        res = subprocess.check_output(["solaar", "show", DEVICE_NAME], stderr=subprocess.DEVNULL).decode()
        state["connected"] = True
        for line in res.splitlines():
            if 'Battery:' in line:
                # e.g., "Battery: 30%, BatteryStatus.DISCHARGING."
                parts = line.split('Battery:', 1)[1].split(',')
                pct_str = parts[0].strip().replace('%', '')
                try:
                    state["battery_percentage"] = int(pct_str)
                except:
                    pass
                if len(parts) > 1:
                    state["battery_state"] = parts[1].strip().replace('.', '').replace('BatteryStatus', '').strip()
    except Exception:
        pass

    return state

def apply_mouse_settings(dpi=None, smartshift=None, threshold=None, hires=None):
    """Set requested settings with optimistic status updates for instant UI feedback."""
    if not find_device():
        return False
    
    # 1. Read existing status from shm (optimistic load)
    state = dict(MOUSE_STATE)
    if os.path.exists(STATUS_FILE):
        try:
            with open(STATUS_FILE, 'r') as f:
                state.update(json.load(f))
        except Exception:
            pass
            
    # 2. Apply target changes optimistically
    if dpi is not None:
        state["dpi"] = dpi
    if smartshift is not None:
        state["smartshift_enabled"] = smartshift
    if threshold is not None:
        state["smartshift_threshold"] = threshold
    if hires is not None:
        state["hires_scroll"] = hires
    state["connected"] = True

    # 3. Write optimistic state immediately to SHM for instant UI feedback
    try:
        temp_file = STATUS_FILE + ".tmp"
        with open(temp_file, "w") as f:
            json.dump(state, f)
        os.rename(temp_file, STATUS_FILE)
    except Exception as e:
        print(f"Error writing optimistic status file: {e}", file=sys.stderr)

    # 4. Apply changes to physical hardware using Solaar
    try:
        if dpi is not None:
            subprocess.run(["solaar", "config", DEVICE_NAME, "dpi", str(dpi)], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if smartshift is not None:
            val = "Ratcheted" if smartshift else "Freespinning"
            subprocess.run(["solaar", "config", DEVICE_NAME, "scroll-ratchet", val], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if threshold is not None:
            subprocess.run(["solaar", "config", DEVICE_NAME, "smart-shift", str(threshold)], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if hires is not None:
            val = "True" if hires else "False"
            subprocess.run(["solaar", "config", DEVICE_NAME, "hires-smooth-resolution", val], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        
        # 5. Final sync with hardware truth
        final_state = get_current_state_dict()
        MOUSE_STATE.update(final_state)
        daemon_write_status()
        return True
    except Exception as e:
        print(f"Error applying mouse settings: {e}", file=sys.stderr)
        return False

def apply_config_file(config_path):
    if not os.path.exists(config_path):
        return False
    try:
        with open(config_path, 'r') as f:
            cfg = json.load(f)
    except Exception as e:
        print(f"Error loading config file: {e}", file=sys.stderr)
        return False

    dpi = cfg.get("dpi")
    smartshift = cfg.get("smartshift_enabled")
    threshold = cfg.get("smartshift_threshold")
    hires = cfg.get("hires_scroll")

    return apply_mouse_settings(dpi=dpi, smartshift=smartshift, threshold=threshold, hires=hires)

# ── Evdev Gesture Event Handling ─────────────────────────────────────

def get_input_device_path():
    try:
        with open('/proc/bus/input/devices', 'r') as f:
            content = f.read()
    except Exception:
        return None
    
    sections = content.split('\n\n')
    for section in sections:
        if 'Logitech MX Master' in section or 'b034' in section.lower():
            for line in section.split('\n'):
                if line.startswith('H: Handlers='):
                    parts = line.split('=')[1].split()
                    for part in parts:
                        if part.startswith('event'):
                            return f'/dev/input/{part}'
    return None

def listen_evdev_loop(dev_path):
    global GESTURE_ACTIVE, GESTURE_DIR
    try:
        fd = os.open(dev_path, os.O_RDONLY | os.O_NONBLOCK)
    except Exception as e:
        print(f"Error opening evdev device: {e}", file=sys.stderr)
        return

    event_format = "QQHHi"
    event_size = struct.calcsize(event_format)

    dx = 0
    dy = 0
    threshold = 40

    gestures = {
        "click": "qs -c ii ipc call mouseMenu toggle",
        "up": "hyprctl dispatch global quickshell:overviewWorkspacesToggle",
        "down": "pavucontrol",
        "left": "hyprctl dispatch workspace -1",
        "right": "hyprctl dispatch workspace +1"
    }

    while True:
        r, _, _ = select.select([fd], [], [], 0.1)
        if r:
            try:
                data = os.read(fd, event_size * 10)
                for i in range(0, len(data), event_size):
                    chunk = data[i:i+event_size]
                    if len(chunk) < event_size:
                        break
                    sec, usec, etype, code, val = struct.unpack(event_format, chunk)
                    
                    if etype == 1: # EV_KEY
                        if code == 277: # BTN_FORWARD (Gesture button)
                            if val == 1: # Pressed
                                GESTURE_ACTIVE = True
                                GESTURE_DIR = "None"
                                dx = 0
                                dy = 0
                                daemon_write_status()
                            elif val == 0: # Released
                                if GESTURE_ACTIVE:
                                    GESTURE_ACTIVE = False
                                    final_dir = GESTURE_DIR
                                    GESTURE_DIR = "None"
                                    
                                    cmd = ""
                                    if final_dir == "None":
                                        cmd = gestures["click"]
                                    elif final_dir == "Up":
                                        cmd = gestures["up"]
                                    elif final_dir == "Down":
                                        cmd = gestures["down"]
                                    elif final_dir == "Left":
                                        cmd = gestures["left"]
                                    elif final_dir == "Right":
                                        cmd = gestures["right"]
                                    
                                    if cmd:
                                        subprocess.Popen(cmd, shell=True)
                                    daemon_write_status()
                    elif etype == 2: # EV_REL
                        if GESTURE_ACTIVE:
                            if code == 0: # REL_X
                                dx += val
                            elif code == 1: # REL_Y
                                dy += val
                            
                            distance = (dx*dx + dy*dy)**0.5
                            new_dir = "None"
                            if distance > threshold:
                                if abs(dx) > abs(dy):
                                    new_dir = "Right" if dx > 0 else "Left"
                                else:
                                    new_dir = "Down" if dy > 0 else "Up"
                            
                            if new_dir != GESTURE_DIR:
                                GESTURE_DIR = new_dir
                                daemon_write_status()
            except Exception:
                break
    os.close(fd)

EVDEV_THREAD = None
CURRENT_EVDEV_PATH = None

def run_evdev_listener():
    global EVDEV_THREAD, CURRENT_EVDEV_PATH
    ev_path = get_input_device_path()
    if ev_path:
        if ev_path != CURRENT_EVDEV_PATH or EVDEV_THREAD is None or not EVDEV_THREAD.is_alive():
            CURRENT_EVDEV_PATH = ev_path
            t = threading.Thread(target=listen_evdev_loop, args=(ev_path,), daemon=True)
            t.start()
            EVDEV_THREAD = t

def run_daemon(config_path):
    print("logitune-cli daemon started (Solaar backend).")
    last_device = None
    loop_count = 0
    while True:
        dev_path = find_device()
        if dev_path:
            run_evdev_listener()
            
            if dev_path != last_device:
                print(f"Mouse detected on {dev_path}. Applying custom settings...")
                time.sleep(1.5)
                if apply_config_file(config_path):
                    last_device = dev_path
                    loop_count = 0
                else:
                    last_device = None
            else:
                loop_count += 1
                if loop_count >= 6: # sync battery / settings every 30s
                    state = get_current_state_dict()
                    MOUSE_STATE.update(state)
                    daemon_write_status()
                    loop_count = 0
        else:
            if last_device is not None:
                print("Mouse disconnected.")
                last_device = None
                MOUSE_STATE["connected"] = False
                daemon_write_status()
        time.sleep(5)

def main():
    parser = argparse.ArgumentParser(description="Lightweight MX Master Settings Tool (Solaar Backend)")
    parser.add_argument("--get", action="store_true", help="Retrieve and print all settings")
    parser.add_argument("--set-dpi", type=int, help="Set cursor resolution (DPI)")
    parser.add_argument("--set-smartshift", choices=["freespin", "ratchet"], help="Set scroll wheel SmartShift mode")
    parser.add_argument("--threshold", type=int, help="Set SmartShift sensitivity threshold (1-255)")
    parser.add_argument("--set-hires", choices=["on", "off"], help="Enable or disable high-res scrolling")
    parser.add_argument("--apply", action="store_true", help="Apply settings defined in the config file")
    parser.add_argument("--daemon", action="store_true", help="Run in daemon mode to configure settings on connection")
    
    args = parser.parse_args()
    config_path = os.path.expanduser("~/.config/logitune-cli.json")

    if args.daemon:
        state = get_current_state_dict()
        MOUSE_STATE.update(state)
        daemon_write_status()
        run_daemon(config_path)
        return

    if args.get:
        state = get_current_state_dict()
        print(json.dumps(state, indent=2))
    elif args.apply:
        success = apply_config_file(config_path)
        sys.exit(0 if success else 1)
    elif args.set_dpi is not None or args.set_smartshift is not None or args.threshold is not None or args.set_hires is not None:
        smartshift = None
        if args.set_smartshift == "freespin":
            smartshift = False
        elif args.set_smartshift == "ratchet":
            smartshift = True

        hires = None
        if args.set_hires == "on":
            hires = True
        elif args.set_hires == "off":
            hires = False

        success = apply_mouse_settings(dpi=args.set_dpi, smartshift=smartshift, threshold=args.threshold, hires=hires)
        sys.exit(0 if success else 1)
    else:
        parser.print_help()

if __name__ == '__main__':
    main()
