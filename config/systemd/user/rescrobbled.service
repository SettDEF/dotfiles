[Unit]
Description=Last.fm scrobbler (YouTube Music only)
Documentation=https://github.com/InputUsername/rescrobbled
Wants=network-online.target
After=network-online.target graphical-session.target
# Waits for the one-time login (see ~/.config/rescrobbled/config.toml).
ConditionPathExists=%h/.config/rescrobbled/session

[Service]
ExecStart=%h/.config/rescrobbled/run.sh
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
