[Unit]
Description=noisewatch — ring buffer of everything that could explain the headset noise

[Service]
Type=simple
ExecStart=%h/.scripts/apps/hdb630/noisewatch.sh daemon
Restart=always
RestartSec=5
# It exists to observe the machine, so it must not perturb it.
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target
