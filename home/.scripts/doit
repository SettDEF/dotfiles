# --- Main Script Logic ---

CONFIG_FILE="${HOME}/.config/todo/config.json"
LAST_PROJECT=""

# Load configuration
load_config_vars() {
  if [[ ! -f "$CONFIG_FILE" ]]; then
    mkdir -p "$(dirname "$CONFIG_FILE")"
    echo '{"projects": [], "editor": "nvim", "use_fzf": 0, "use_tmux": 0}' > "$CONFIG_FILE"
  fi
  if command_exists jq; then
    EDITOR=$(jq -r '.editor // "nvim"' "$CONFIG_FILE")
    USE_FZF=$(jq -r '.use_fzf // 0' "$CONFIG_FILE")
    USE_TMUX=$(jq -r '.use_tmux // 0' "$CONFIG_FILE")
  fi
}

# Ensure timer directory exists
mkdir -p "$TIMER_DIR"

# Load configuration
load_config_vars

