						wcag_white.aaa_large,
						wcag_black.aa_normal,
						wcag_black.aa_large,
						wcag_black.aaa_normal,
						wcag_black.aaa_large
					)
			elseif test_method == "luminance" then
				local lum = Color.calculate_luminance(color.hex)
				comment = comment .. string.format(" | Luminance: %.3f", lum)
			elseif test_method == "foreground" then
				local score = Color.evaluate_foreground_effectiveness(color, colors)
				comment = comment
					.. string.format(
						" | Score: %.2f | Contrast: %.2f | Versatility: %.1f%%",
						score.overall,
						score.contrast,
						score.versatility
					)
			end
			local var_name = get_variable_name(color, i)
			if var_name:sub(1, 1) ~= "$" then
				var_name = "$" .. var_name
			end
			local hex_display = color.hex
			if Utils.is_ansi_supported() then
				local fg = Color.get_contrast_text_color(color.r, color.g, color.b)
				hex_display = String:new(color.hex):colorize(fg[1], fg[2], fg[3], color.r, color.g, color.b).value
			end
			print(string.format("  %s: %s; // %s", var_name, hex_display, comment))
		end
	end
end

-- Argument Parsing ------------------------------------------------------------
local Args = {}

function Args.parse(args)
	local valid_algorithms = {
		lightness = true,
		saturation = true,
		hue = true,
		complementary = true,
		triadic = true,
		analogous = true,
		blend = true,
	}
	local valid_test_methods = { contrast = true, colorblind = true, wcag = true, luminance = true, foreground = true }
	local valid_formats = { table = true, json = true, css = true, scss = true, verbose = true }

	local result = {
		command = nil,
		algorithm = "lightness",
		hex = nil,
		hex2 = nil,
		count = 5,
		verbose = false,
		format = "table",
		show_names = false,
		test = nil,
		show_swatch = true,
		blend_ratio = nil,
		blend_hex = nil,
		min_contrast = Config.fg_bg_test.min_contrast,
		name_format = nil,
	}

	local i = 1
	local command_found = false
	local args_to_process = {}

	-- Collect arguments that might be hex colors
	while i <= #args do
		local arg = args[i]
		if arg == "palette" or arg == "blend" then
			if command_found then
				error("Multiple commands specified. Use only one of 'palette' or 'blend'.")
			end
			result.command = arg
			command_found = true
			i = i + 1
		elseif arg == "--algorithm" or arg == "--algo" then
			i = i + 1
			if not args[i] or not valid_algorithms[args[i]] then
				error("Invalid or missing algorithm after --algorithm/--algo. Use --help for available algorithms.")
			end
			result.algorithm = args[i]
			i = i + 1
		elseif arg:match("^--algorithm=(.+)$") then
			local method = arg:match("^--algorithm=(.+)$")
			if not valid_algorithms[method] then
				error("Invalid algorithm: " .. method .. ". Use --help for available algorithms.")
			end
			result.algorithm = method
			i = i + 1
		elseif arg:match("^--count=(%d+)$") then
			local count = tonumber(arg:match("^--count=(%d+)$"))
			if count < 1 or count > 20 then
				error("Count must be between 1 and 20.")
			end
			result.count = count
			i = i + 1
		elseif arg == "--count" then
			i = i + 1
			if not args[i] or not args[i]:match("^%d+$") then
				error("Invalid or missing count value after --count. Use a number between 1 and 20.")
			end
			local count = tonumber(args[i])
			if count < 1 or count > 20 then
				error("Count must be between 1 and 20.")
			end
			result.count = count
			i = i + 1
		elseif arg == "--verbose" then
			result.verbose = true
			i = i + 1
		elseif arg == "--format" then
			i = i + 1
			if not args[i] or not valid_formats[args[i]] then
				error("Invalid or missing format after --format. Use --help for available formats.")
			end
			result.format = args[i]
			i = i + 1
		elseif arg:match("^--format=(.+)$") then
			local fmt = arg:match("^--format=(.+)$")
			if not valid_formats[fmt] then
				error("Invalid format: " .. fmt .. ". Use --help for available formats.")
			end
			result.format = fmt
			i = i + 1
		elseif arg == "--no-names" then
			result.show_names = false
			i = i + 1
		elseif arg == "--names" then
			result.show_names = true
			i = i + 1
		elseif arg == "--test" then
			i = i + 1
			if not args[i] or not valid_test_methods[args[i]] then
				error("Invalid or missing test method after --test. Use --help for available test methods.")
			end
			result.test = args[i]
			i = i + 1
		elseif arg:match("^--test=(.+)$") then
			local test = arg:match("^--test=(.+)$")
			if not valid_test_methods[test] then
				error("Invalid test method: " .. test .. ". Use --help for available test methods.")
			end
			result.test = test
			i = i + 1
		elseif arg == "--no-swatch" then
			result.show_swatch = false
			i = i + 1
		elseif arg == "--blend-ratio" then
			i = i + 1
			if not args[i] or not args[i]:match("^%d*%.?%d+$") then
				error("Invalid or missing blend ratio after --blend-ratio. Use a number between 0 and 1.")
			end
			local ratio = tonumber(args[i])
			if ratio < 0 or ratio > 1 then
				error("Blend ratio must be between 0 and 1.")
			end
			result.blend_ratio = ratio
			i = i + 1
		elseif arg:match("^--blend-ratio=(%d*%.?%d+)$") then
			local ratio = tonumber(arg:match("^--blend-ratio=(%d*%.?%d+)$"))
			if ratio < 0 or ratio > 1 then
				error("Blend ratio must be between 0 and 1.")
			end
			result.blend_ratio = ratio
			i = i + 1
		elseif arg == "--min-contrast" then
			i = i + 1
			if not args[i] or not args[i]:match("^%d*%.?%d+$") then
				error("Invalid or missing contrast ratio after --min-contrast. Use a number.")
			end
			result.min_contrast = tonumber(args[i])
			i = i + 1
		elseif arg:match("^--min-contrast=(%d*%.?%d+)$") then
			result.min_contrast = tonumber(arg:match("^--min-contrast=(%d*%.?%d+)$"))
			i = i + 1
		elseif arg == "--name-format" then
			i = i + 1
			if not args[i] then
				error("Missing value after --name-format.")
			end
			result.name_format = args[i]
			i = i + 1
		elseif arg:match("^--name-format=(.+)$") then
			result.name_format = arg:match("^--name-format=(.+)$")
			i = i + 1
		elseif arg == "--help" then
			result.command = "help"
			i = i + 1
		else
			-- Collect non-option arguments (potential hex colors)
			table.insert(args_to_process, arg)
			i = i + 1
		end
	end

	-- Process collected arguments as hex colors
	if result.command == "palette" then
		if #args_to_process == 0 then
			error("Palette command requires a hex color (e.g., '#RRGGBB').")
		end
		local hex_arg = args_to_process[1]:gsub("[\"']", "") -- Remove quotes if present
		local valid, normalized = Color.validate_hex(hex_arg)
		if not valid then
			error(normalized)
		end
		if #args_to_process > 1 then
			local second_arg = args_to_process[2]:gsub("[\"']", "")
			if Color.validate_hex(second_arg) then
				error("Palette command accepts only one hex color.")
			end
		end
		result.hex = normalized
	elseif result.command == "blend" then
		if #args_to_process < 2 then
			error("Blend command requires two hex colors (e.g., '#RRGGBB #RRGGBB').")
		elseif #args_to_process > 2 then
			error("Blend command accepts only two hex colors.")
		end
		local valid1, normalized1 = Color.validate_hex(args_to_process[1])
		local valid2, normalized2 = Color.validate_hex(args_to_process[2])
		if not valid1 then
			error(normalized1)
		end
		if not valid2 then
			error(normalized2)
		end
		result.hex = normalized1
		result.hex2 = normalized2
		if not result.blend_ratio then
			result.blend_ratio = 0.5 -- Default blend ratio
		end
	elseif result.command == nil and #args_to_process > 0 then
		-- Assume 'palette' if no command is specified but hex color is provided
		if #args_to_process > 1 then
			error("Only one hex color is allowed when no command is specified.")
		end
		local valid, normalized = Color.validate_hex(args_to_process[1])
		if not valid then
			error(normalized)
		end
		result.command = "palette"
		result.hex = normalized
	end

	if result.command == nil then
		result.command = "help"
	end

	return result
end

-- Main Execution --------------------------------------------------------------
local function show_help()
	print([[
Enhanced Color Tool (cpie) v2.1
Generate and analyze color palettes with advanced features.

Usage:
  cpie palette <hex> [options]        Generate a color palette from a single hex color
  cpie blend <hex1> <hex2> [options]  Blend two colors
  cpie --help                         Show this help message

Options:
  --algorithm=<method>, --algo=<method>  Palette generation method (default: lightness)
                                        Available: lightness, saturation, hue, complementary, triadic, analogous, blend
  --count=<n>                           Number of colors to generate (1-20, default: 5)
  --verbose                             Enable verbose output
  --format=<type>                       Output format: table, json, css, scss, verbose (default: table)
  --names                               Show color names in table output
  --no-names                            Hide color names in table output (default)
  --test=<method>                       Perform color analysis: contrast, colorblind, wcag, luminance, foreground
  --no-swatch                           Disable color swatches in table output
  --blend-ratio=<n>                     Blend ratio for blend command (0-1, default: 0.5)
  --min-contrast=<n>                    Minimum contrast ratio for fg/bg pairs (default: 4.5)
  --name-format=<pattern>               Custom variable name format for CSS/SCSS (e.g., "color-{name}-{index}")

Examples:
  cpie palette '#B5B1A4' --algorithm=analogous --count=5 --format=scss
  cpie palette '#FF0000' --test=wcag --names
  cpie blend '#FF0000' '#0000FF' --blend-ratio=0.3 --format=json
  cpie '#B5B1A4' --count=3 --format=css --name-format="color-{name}-{index}"

Note: Hex colors should be quoted if they include '#' (e.g., '#FF0000') to avoid shell issues.
]])
	os.exit(0)
end

local function main()
	local args = Args.parse(arg)
	if args.command == "help" then
		show_help()
	end

	local colors, palette_name

	if args.command == "palette" then
		Utils.update_progress("Generating palette for " .. args.hex .. "...")
		if args.algorithm == "lightness" then
			colors, palette_name = Palette.generate_lightness(args.hex, args.count, args.verbose)
		elseif args.algorithm == "saturation" then
			colors, palette_name = Palette.generate_saturation(args.hex, args.count, args.verbose)
		elseif args.algorithm == "hue" then
			colors, palette_name = Palette.generate_hue(args.hex, args.count, args.verbose)
		elseif args.algorithm == "complementary" then
			colors, palette_name = Palette.generate_complementary(args.hex, args.count, args.verbose)
		elseif args.algorithm == "triadic" then
			colors, palette_name = Palette.generate_triadic(args.hex, args.count, args.verbose)
		elseif args.algorithm == "analogous" then
			colors, palette_name = Palette.generate_analogous(args.hex, args.count, args.verbose)
		else
			error("Unsupported algorithm: " .. args.algorithm)
		end
	elseif args.command == "blend" then
		Utils.update_progress("Blending colors " .. args.hex .. " and " .. args.hex2 .. "...")
		if args.count > 1 then
			colors, palette_name = Palette.generate_blend(args.hex, args.hex2, args.count, args.verbose)
		else
			colors, palette_name = Palette.generate_blended_palette(args.hex, args.hex2, args.blend_ratio, args.verbose)
		end
	end

	Display.format_output(
		args.format,
		colors,
		palette_name,
		args.show_names,
		args.test,
		args.show_swatch,
		args.name_format
	)
end

main()
