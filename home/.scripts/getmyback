#!/bin/bash

# Dotfiles Backup Script
# Backs up specified dotfiles and folders, merges old and new files smartly, and supports Git integration.

# Configuration
PREFERRED_DIR="/mnt/usr/mars/dotfiles"
TIME_STAMP=$(date +%Y%m%d_%H%M%S)
if [[ -d "$PREFERRED_DIR" ]]; then
    BACKUP_DIR="$PREFERRED_DIR/FROM_$TIME_STAMP"
    LOG_FILE="$BACKUP_DIR/backup.log"
else
    BACKUP_DIR="$HOME/dotfiles_backup/$TIME_STAMP"
    LOG_FILE="$BACKUP_DIR/backup.log"
fi

DOTFILES=(
    "$HOME/.bash_history"
    "$HOME/.bash_logout"
